#!/usr/bin/env bash
# Axiom VPS Manager — Squid Proxy Modern Installer
set -euo pipefail

# Clean up any leftover legacy trusty repository files
rm -f /etc/apt/sources.list.d/trusty_sources.list

echo -e "\033[1;33m[*] Installing native Squid Proxy package...\033[0m"
export DEBIAN_FRONTEND=noninteractive
apt-get update -y >/dev/null 2>&1 || true
apt-get install -y squid >/dev/null 2>&1 || apt-get install -y squid3 >/dev/null 2>&1

# Basic configuration directory
mkdir -p /etc/squid
touch /etc/squid/payload.txt

systemctl enable squid 2>/dev/null || systemctl enable squid3 2>/dev/null || true
systemctl restart squid 2>/dev/null || systemctl restart squid3 2>/dev/null || true

echo -e "\033[1;32m[✓] Native Squid Proxy installed and active.\033[0m"