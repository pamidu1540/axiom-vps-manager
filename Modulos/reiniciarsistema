#!/usr/bin/env bash
set -euo pipefail

clear
echo -e "\033[1;33m=====================================================\033[0m"
echo -e "\033[1;31m             REBOOT SERVER CONFIRMATION              \033[0m"
echo -e "\033[1;33m=====================================================\033[0m\n"

read -r -p "Are you sure you want to restart the server? [y/N]: " confirm
case "$confirm" in
    [yY]|[yY][eE][sS]|[sS]|[sS][iI][mM])
        echo -e "\n\033[1;31m◇ RESTARTING SYSTEM NOW...\033[0m"
        sleep 1
        shutdown -r now 2>/dev/null || reboot 2>/dev/null || systemctl reboot 2>/dev/null || true
        ;;
    *)
        echo -e "\n\033[1;32m◇ Reboot cancelled.\033[0m"
        sleep 1
        ;;
esac
