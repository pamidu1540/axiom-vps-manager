#!/usr/bin/env bash
# Axiom VPS Manager — Trial Generator Telegram Bot Activator

if [[ $(screen -list 2>/dev/null | grep -c 'bot_teste') -eq 0 ]]; then
    clear
    echo -e "\E[44;1;37m        ⚡ Axiom Trial Bot Activation ⚡        \E[0m\n"
    echo -ne "\033[1;32m◇ Enter Telegram Bot Token from @BotFather\033[1;37m: "; read -r token
    
    mkdir -p /etc/VPSManager
    cd /etc/VPSManager
    screen -dmS bot_teste ./botsshteste "$token" > /dev/null 2>&1 || true
    
    touch /etc/autostart
    sed -i '/bot_teste/d' /etc/autostart 2>/dev/null || true
    echo "ps x | grep 'bot_teste' | grep -v 'grep' || cd /etc/VPSManager && sudo screen -dmS bot_teste ./botsshteste '$token' && cd \$HOME" >> /etc/autostart
    
    clear && echo -e "\033[1;32m[✓] Trial Bot Activated successfully!\033[0m"
else
    screen -r -S "bot_teste" -X quit 2>/dev/null || true
    sed -i '/bot_teste/d' /etc/autostart 2>/dev/null || true
    clear && echo -e "\033[1;31m[✓] Trial Bot Deactivated.\033[0m"
fi
