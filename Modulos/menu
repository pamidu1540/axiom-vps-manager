export PATH="/opt/axiom/Modulos:/usr/local/bin:/usr/bin:/bin:$PATH"
export PYTHONPATH="/opt/axiom/src:${PYTHONPATH:-}"

# Dispatch to menu2 directly if requested
if [[ "${1:-}" == "menu2" || "${1:-}" == "advanced" || "${1:-}" == "19" ]]; then
    # Will be called after menu2 function definition
    _DIRECT_MENU2=1
fi

# Dispatch to Python CLI if subcommands or flags were provided
if [[ $# -gt 0 && "${1:-}" != "menu2" && "${1:-}" != "advanced" && "${1:-}" != "19" && "${1:-}" != "menu" ]]; then
    if command -v python3 >/dev/null 2>&1; then
        exec python3 -m axiom.cli "$@"
    fi
fi

# Color Definitions
CLR_RESET='\033[0m'
CLR_RED='\033[1;31m'
CLR_GREEN='\033[1;32m'
CLR_YELLOW='\033[1;33m'
CLR_BLUE='\033[1;34m'
CLR_MAGENTA='\033[1;35m'
CLR_CYAN='\033[1;36m'
CLR_WHITE='\033[1;37m'
CLR_BOLD='\033[1m'
CLR_DIM='\033[2m'
BG_BLUE='\033[44;1;37m'
BG_CYAN='\033[46;1;30m'

fun_bar() {
    local cmd1="${1:-}"
    local cmd2="${2:-}"
    local pid
    (
        eval "$cmd1" >/dev/null 2>&1
        [[ -n "$cmd2" ]] && eval "$cmd2" >/dev/null 2>&1
    ) &
    pid=$!

    local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0
    local timeout=60
    local elapsed=0

    tput civis 2>/dev/null || true
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${CLR_YELLOW}Processing... [${CLR_CYAN}%s${CLR_YELLOW}]${CLR_RESET} " "${spin[i % 10]}"
        ((i++))
        sleep 0.1
        ((elapsed += 1))
        if (( elapsed > timeout * 10 )); then
            kill -9 "$pid" 2>/dev/null || true
            break
        fi
    done
    wait "$pid" 2>/dev/null || true
    printf "\r  ${CLR_YELLOW}Processing... [${CLR_GREEN}✔${CLR_YELLOW}] - ${CLR_GREEN}DONE!${CLR_RESET}\n"
    tput cnorm 2>/dev/null || true
}

IP=$(cat /etc/IP 2>/dev/null || curl -s -4 --connect-timeout 3 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")

# Limiter controls
limit1() {
    clear
    echo -e "\n${CLR_GREEN}⚡ Starting Axiom Connection Limiter Daemon...${CLR_RESET}\n"
    fun_bar 'screen -dmS limiter limiter' 'sleep 2'
    if ! grep -q "limiter" /etc/autostart 2>/dev/null; then
        echo "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
    fi
    echo -e "\n${CLR_GREEN}[✓] User Limiter is now ACTIVE.${CLR_RESET}"
    sleep 1.5
}

limit2() {
    clear
    echo -e "\n${CLR_YELLOW}⚡ Stopping Axiom Connection Limiter Daemon...${CLR_RESET}\n"
    fun_stplimiter() {
        sleep 1
        screen -r -S "limiter" -X quit 2>/dev/null || true
        screen -wipe >/dev/null 2>&1 || true
        sed -i '/limiter/d' /etc/autostart 2>/dev/null || true
        sleep 1
    }
    fun_bar 'fun_stplimiter' 'sleep 2'
    echo -e "\n${CLR_RED}[✓] User Limiter STOPPED.${CLR_RESET}"
    sleep 1.5
}

limit_ssh() {
    if ps x 2>/dev/null | grep "limiter" | grep -v grep >/dev/null; then
        limit2
    else
        limit1
    fi
}

# Auto-execute toggle (runs axiom on VM boot / login)
autoexec() {
    if [[ -f /etc/axiom/autolaunch ]] || grep -q "axiom;" /etc/profile 2>/dev/null || grep -q "menu;" /etc/profile 2>/dev/null; then
        clear
        echo -e "${CLR_YELLOW}⚡ Disabling Axiom Auto-Execution on Login...${CLR_RESET}\n"
        offautmenu() {
            rm -f /etc/axiom/autolaunch 2>/dev/null || true
            sed -i '/menu;/d' /etc/profile 2>/dev/null || true
            sed -i '/axiom;/d' /etc/profile 2>/dev/null || true
        }
        fun_bar 'offautmenu'
        echo -e "\n${CLR_RED}[✓] Auto-Execution DISABLED (Standard shell on login).${CLR_RESET}"
        sleep 1.5
    else
        clear
        echo -e "${CLR_GREEN}⚡ Activating Axiom Auto-Execution on Login...${CLR_RESET}\n"
        autmenu() {
            mkdir -p /etc/axiom 2>/dev/null || true
            touch /etc/axiom/autolaunch 2>/dev/null || true
            sed -i '/menu;/d' /etc/profile 2>/dev/null || true
            sed -i '/axiom;/d' /etc/profile 2>/dev/null || true
        }
        fun_bar 'autmenu'
        echo -e "\n${CLR_GREEN}[✓] Auto-Execution ENABLED (Axiom directly opens on VM boot/login).${CLR_RESET}"
        sleep 1.5
    fi
}

# ==============================================================================
# ADVANCED MENU 2
# ==============================================================================
menu2() {
    while true; do
        if [[ ! -d /opt/axiom/Modulos && ! -f "${BASH_SOURCE[0]:-$0}" ]]; then
            exit 0
        fi

        local stsf autm stsbot system _ons _expuser _onop _drp _ondrp _onli _ram _usor _usop _core _system _hora _tuser
        [[ -e /etc/axiom/torrent_blocked || -e /etc/Plus-torrent ]] && stsf="${CLR_GREEN}● ON ${CLR_RESET}" || stsf="${CLR_RED}○ OFF${CLR_RESET}"
        if [[ -f /etc/axiom/autolaunch ]] || grep -q -E "axiom;|menu;" /etc/profile 2>/dev/null; then
            autm="${CLR_GREEN}● ON ${CLR_RESET}"
        else
            autm="${CLR_RED}○ OFF${CLR_RESET}"
        fi
        [[ $(ps x 2>/dev/null | grep "bot_plus" | grep -v grep | wc -l) -gt 0 || $(systemctl is-active --quiet axiom-bot 2>/dev/null && echo "1" || echo "0") == "1" ]] && stsbot="${CLR_GREEN}● ON ${CLR_RESET}" || stsbot="${CLR_RED}○ OFF${CLR_RESET}"

        if [[ -f /etc/os-release ]]; then
            . /etc/os-release
            system="${NAME:-Linux} ${VERSION_ID:-}"
        else
            system=$(cat /etc/issue.net 2>/dev/null || uname -s)
        fi

        _ons=$(ps x 2>/dev/null | grep sshd | grep -v root | grep priv | wc -l)
        _ons=$(echo "$_ons" | tr -dc '0-9'); [[ -z "$_ons" ]] && _ons=0

        _expuser=$(cat /etc/VPSManager/Exp 2>/dev/null || echo "0")
        _expuser=$(echo "$_expuser" | tr -dc '0-9'); [[ -z "$_expuser" ]] && _expuser=0

        _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log 2>/dev/null || true)
        _onop=$(echo "$_onop" | tr -dc '0-9'); [[ -z "$_onop" ]] && _onop=0

        if [[ -e /etc/default/dropbear ]]; then
            _drp=$(ps aux 2>/dev/null | grep dropbear | grep -v grep | wc -l)
            _drp=$(echo "$_drp" | tr -dc '0-9'); [[ -z "$_drp" ]] && _drp=0
            _ondrp=$(( _drp > 0 ? _drp - 1 : 0 ))
        else
            _ondrp=0
        fi

        _onli=$(( _ons + _onop + _ondrp ))
        _ram=$(free -h 2>/dev/null | grep -i mem | awk '{print $3 "/" $2}' || echo "N/A")
        _usor=$(free -m 2>/dev/null | awk 'NR==2{printf "%.1f%%", $3*100/$2 }' || echo "N/A")
        _usop=$(top -bn1 2>/dev/null | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }' || echo "N/A")
        _core=$(grep -c cpu[0-9] /proc/stat 2>/dev/null || true)
        _core=$(echo "$_core" | tr -dc '0-9'); [[ -z "$_core" ]] && _core=1
        _system=$(printf '%-18s' "$system")
        _hora=$(printf '%(%H:%M:%S)T' -1 2>/dev/null || date +%H:%M:%S)
        _tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd 2>/dev/null | grep -v nobody | wc -l)
        _tuser=$(echo "$_tuser" | tr -dc '0-9'); [[ -z "$_tuser" ]] && _tuser=0

        clear
        echo -e "${CLR_CYAN}╭─────────────────────────────────────────────────────────────╮${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_YELLOW}${CLR_BOLD}⚡ AXIOM VPS MANAGER — ADVANCED OPERATIONS ⚡${CLR_RESET}       ${CLR_CYAN}v1.0.2 │${CLR_RESET}"
        echo -e "${CLR_CYAN}├─────────────────────────────────────────────────────────────┤${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}  ${CLR_WHITE}OS:${CLR_RESET} $_system ${CLR_WHITE}RAM:${CLR_RESET} $_ram (${_usor}) ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}  ${CLR_WHITE}CPU:${CLR_RESET} $_core Core(s) (${_usop})  ${CLR_WHITE}Uptime / Time:${CLR_RESET} $_hora         ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}  ${CLR_WHITE}Public IP:${CLR_RESET} $IP  ${CLR_WHITE}Online Sessions:${CLR_RESET} $_onli | ${CLR_WHITE}Users:${CLR_RESET} $_tuser  ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}├─────────────────────────────────────────────────────────────┤${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}  ${CLR_CYAN}${CLR_BOLD}⚙️  SYSTEM & PROXY CONTROLS${CLR_RESET}                                  ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_CYAN}[20]${CLR_RESET} Add Proxy Host          ${CLR_CYAN}[26]${CLR_RESET} Change Root Password    ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_CYAN}[21]${CLR_RESET} Remove Proxy Host       ${CLR_CYAN}[27]${CLR_RESET} Auto-Launch (${autm})   ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_CYAN}[22]${CLR_RESET} Reboot Server           ${CLR_CYAN}[28]${CLR_RESET} Check Updates           ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_CYAN}[23]${CLR_RESET} Restart Services        ${CLR_CYAN}[29]${CLR_RESET} Uninstall Axiom         ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_CYAN}[24]${CLR_RESET} Torrent Block (${stsf}) ${CLR_CYAN}[30]${CLR_RESET} Return to Main Menu     ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}│${CLR_RESET}   ${CLR_CYAN}[25]${CLR_RESET} Telegram Bot (${stsbot})  ${CLR_RED}[00]${CLR_RESET} Exit                    ${CLR_CYAN}│${CLR_RESET}"
        echo -e "${CLR_CYAN}╰─────────────────────────────────────────────────────────────╯${CLR_RESET}"
        echo ""
        echo -ne "${CLR_YELLOW}⚡ Enter option [20-30 or 00]: ${CLR_RESET}"; read -r opt2

        case "$opt2" in
            20) clear; addhost ;;
            21) clear; delhost ;;
            22) clear; reiniciarsistema ;;
            23) clear; reiniciarservicos; sleep 2 ;;
            24) blockt ;;
            25) botssh ;;
            26) clear; senharoot; sleep 2 ;;
            27) autoexec ;;
            28) attscript ;;
            29) clear; delscript; exit 0 ;;
            30|back|b) return 0 ;;
            0|00|q|exit) echo -e "\n${CLR_GREEN}Goodbye!${CLR_RESET}\n"; exit 0 ;;
            *) echo -e "\n${CLR_RED}[!] Invalid option.${CLR_RESET}"; sleep 1.5 ;;
        esac
    done
}

