#!/usr/bin/env bash
# Axiom VPS Manager — Password Change Module
set -euo pipefail

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-10s\n' "  Axiom - Change User Password  " ; tput sgr0
echo ""

database="/root/usuarios.db"
touch "$database"

mapfile -t users_list < <(awk '{print $1}' "$database" | sort -u)
if [[ ${#users_list[@]} -eq 0 ]]; then
    echo -e "\033[1;31mNo managed users found.\033[0m\n"
    exit 0
fi

echo -e "\033[1;33mSelect a user to change password:\033[0m\n"
for i in "${!users_list[@]}"; do
    idx=$((i + 1))
    echo -e "[\033[1;32m$idx\033[0m] ${users_list[$i]}"
done
echo ""

read -r -p "Enter number or username: " sel
target_user=""
if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#users_list[@]} )); then
    target_user="${users_list[$((sel - 1))]}"
elif grep -qw "$sel" "$database"; then
    target_user="$sel"
fi

if [[ -z "$target_user" ]] || ! id "$target_user" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User not found or invalid selection.\033[0m\n"
    exit 1
fi

read -r -s -p "Enter new password for $target_user (min 8 chars, empty for random): " new_pass
echo ""
if [[ -z "$new_pass" ]]; then
    new_pass=$(tr -dc A-Za-z0-9 </dev/urandom | head -c 12 || echo "$((RANDOM % 899999 + 100000))")
fi

if [[ ${#new_pass} -lt 8 ]]; then
    echo -e "\n\033[1;31m[!] Password must be at least 8 characters long.\033[0m\n"
    exit 1
fi

# Disconnect existing sessions for this user safely
pkill -u "$target_user" 2>/dev/null || true

# Update password via chpasswd
echo "$target_user:$new_pass" | chpasswd

echo -e "\n\033[1;32m[✓] Password for user '$target_user' successfully updated.\033[0m"
echo -e "    New Password: \033[1;33m$new_pass\033[0m\n"
read -r -p "Press Enter to return to menu..."
