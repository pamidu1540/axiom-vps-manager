#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Password Change Module
# ==============================================================================


# Source common library
LIB_PATH="/etc/axiom/lib/axiom-common.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
    LIB_PATH="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/lib/axiom-common.sh"
fi
if [[ -f "$LIB_PATH" ]]; then
    # shellcheck source=lib/axiom-common.sh
    source "$LIB_PATH"
fi

if type axiom_require_root >/dev/null 2>&1; then
    axiom_require_root
elif [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[!] Error: Axiom operations require root privileges.\033[0m" >&2
    read -r -p "⚡ Press [ENTER] to return..."
    exit 1
fi

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-10s\n' "  Axiom - Change User Password  " ; tput sgr0
echo ""

database="/root/usuarios.db"
touch "$database" 2>/dev/null || true

mapfile -t users_list < <(awk '{print $1}' "$database" 2>/dev/null | sort -u)
if [[ ${#users_list[@]} -eq 0 ]]; then
    mapfile -t users_list < <(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null | sort -u)
fi

if [[ ${#users_list[@]} -eq 0 ]]; then
    echo -e "\033[1;31mNo managed users found.\033[0m\n"
    read -r -p "⚡ Press [ENTER] to return..."
    exit 0
fi

echo -e "\033[1;33mSelect a user to change password:\033[0m\n"
for i in "${!users_list[@]}"; do
    idx=$((i + 1))
    echo -e "[\033[1;32m$idx\033[0m] ${users_list[$i]}"
done
echo ""

read -r -p "Enter number or username (or '0' to cancel): " sel
if [[ "$sel" == "0" || "$sel" == "q" || -z "$sel" ]]; then
    exit 0
fi

target_user=""
if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#users_list[@]} )); then
    target_user="${users_list[$((sel - 1))]}"
elif id "$sel" >/dev/null 2>&1; then
    target_user="$sel"
fi

if [[ -z "$target_user" ]] || ! id "$target_user" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User not found or invalid selection.\033[0m\n"
    read -r -p "⚡ Press [ENTER] to return..."
    exit 0
fi

read -r -s -p "Enter new password for $target_user (min 8 chars, press Enter for auto-generate): " new_pass
echo ""
if [[ -z "$new_pass" ]]; then
    new_pass=$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 12 || echo "Ax$(date +%s%N | tail -c 8)")
fi

if [[ ${#new_pass} -lt 8 ]]; then
    echo -e "\n\033[1;31m[!] Password must be at least 8 characters long.\033[0m\n"
    read -r -p "⚡ Press [ENTER] to return..."
    exit 0
fi

# Disconnect existing sessions for this user safely
pkill -u "$target_user" 2>/dev/null || true

# Update password via chpasswd over stdin (zero plaintext files written to disk)
echo "$target_user:$new_pass" | chpasswd

if type axiom_audit >/dev/null 2>&1; then
    axiom_audit "USER_CHANGE_PASSWORD" "$target_user" "length=${#new_pass}"
fi

echo -e "\n\033[1;32m[✓] Password for user '$target_user' successfully updated.\033[0m"
echo -e "    New Password: \033[1;33m$new_pass\033[0m\n"
read -r -p "⚡ Press [ENTER] to return to menu..."
