#!/usr/bin/env bash
set -euo pipefail
clear

echo -e "\E[44;1;37m  Username         Status     Limit      Validity     \E[0m"
echo ""

database="/root/usuarios.db"
touch "$database"

while read -r user_line; do
    [[ -z "$user_line" ]] && continue
    users=$(echo "$user_line" | awk '{print $1}')
    lim=$(echo "$user_line" | awk '{print $2}')
    [[ -z "$lim" ]] && lim="1"

    if ! id "$users" >/dev/null 2>&1; then
        continue
    fi

    datauser=$(chage -l "$users" 2>/dev/null | grep -i "Account expires" | awk -F : '{print $2}' | xargs || echo "never")
    if [[ "$datauser" == "never" || -z "$datauser" ]]; then
        data="\033[1;33mNever\033[0m"
    else
        databr=$(date -d "$datauser" +"%Y%m%d" 2>/dev/null || echo "99999999")
        hoje=$(date +"%Y%m%d")
        if [[ "$hoje" -ge "$databr" ]]; then
            data="\033[1;31mExpired\033[0m"
        else
            diff_days=$(( ( $(date -d "$datauser" +%s) - $(date +%s) ) / 86400 ))
            data="\033[1;32m${diff_days} Days\033[0m"
        fi
    fi

    Usuario=$(printf '%-16s' "$users")
    Status=$(printf '%-10s' "Active")
    Limite=$(printf '%-10s' "$lim")
    echo -e "\033[1;33m$Usuario \033[1;37m$Status \033[1;36m$Limite \033[1;32m$data\033[0m"
    echo -e "\033[0;34m──────────────────────────────────────────────────────\033[0m"
done < "$database"

echo ""
_tuser=$(awk '{print $1}' "$database" | wc -l)
_ons=$(ps -x 2>/dev/null | grep sshd | grep -v root | grep priv | wc -l || echo "0")
echo -e "\033[1;33mTotal Accounts: \033[1;37m$_tuser \033[1;33m| Online SSH Sessions: \033[1;32m$_ons\033[0m"
