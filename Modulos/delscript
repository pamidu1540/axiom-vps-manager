#!/usr/bin/env bash
# Axiom VPS Manager — Menu Uninstaller Invocation

if [[ -f /opt/axiom/uninstall.sh ]]; then
    exec bash /opt/axiom/uninstall.sh
elif [[ -f "$(dirname "$0")/../uninstall.sh" ]]; then
    exec bash "$(dirname "$0")/../uninstall.sh"
else
    # Fallback to fetching remote clean uninstaller
    curl -fsSL https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/uninstall.sh -o /tmp/uninstall.sh
    exec bash /tmp/uninstall.sh
fi
