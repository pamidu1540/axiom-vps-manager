#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Script Update Checker & Installer
# ==============================================================================


CLR_RESET='\033[0m'
CLR_RED='\033[1;31m'
CLR_GREEN='\033[1;32m'
CLR_YELLOW='\033[1;33m'
CLR_CYAN='\033[1;36m'
CLR_BOLD='\033[1m'

clear
echo -e "${CLR_CYAN}====================================================${CLR_RESET}"
echo -e "${CLR_YELLOW}${CLR_BOLD}       ⚡ Axiom VPS Manager — Update Checker ⚡        ${CLR_RESET}"
echo -e "${CLR_CYAN}====================================================${CLR_RESET}\n"

fun_bar() {
    local cmd1="${1:-}"
    local pid
    ( eval "$cmd1" >/dev/null 2>&1 ) &
    pid=$!

    local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0
    local timeout=30
    local elapsed=0

    tput civis 2>/dev/null || true
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${CLR_YELLOW}Checking for updates... [${CLR_CYAN}%s${CLR_YELLOW}]${CLR_RESET} " "${spin[i % 10]}"
        ((i++))
        sleep 0.1
        ((elapsed += 1))
        if (( elapsed > timeout * 10 )); then
            kill -9 "$pid" 2>/dev/null || true
            break
        fi
    done
    wait "$pid" 2>/dev/null || true
    printf "\r  ${CLR_YELLOW}Checking for updates... [${CLR_GREEN}✔${CLR_YELLOW}] - ${CLR_GREEN}DONE!${CLR_RESET}\n"
    tput cnorm 2>/dev/null || true
}

fetch_remote_version() {
    rm -f /tmp/att 2>/dev/null || true
    curl -fsSL -o /tmp/att https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/Install/versao 2>/dev/null || \
    wget -q -O /tmp/att https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/Install/versao 2>/dev/null || true
}

fun_bar 'fetch_remote_version'

if [[ ! -f "/tmp/att" || ! -s "/tmp/att" ]]; then
    echo -e "\n${CLR_RED}[!] Could not reach GitHub update server. Check internet connection.${CLR_RESET}\n"
    read -r -p "Press Enter to return..."
    exit 0
fi

local_versao=""
for vf in /bin/versao /etc/axiom/versao /opt/axiom/versao /etc/VPSManager/versao; do
    if [[ -f "$vf" ]]; then
        local_versao="$vf"
        break
    fi
done

if [[ -n "$local_versao" ]]; then
    vrs1=$(sed -n '1 p' "$local_versao" 2>/dev/null | sed -e 's/[^0-9]//g' || echo "100")
else
    vrs1="100"
fi
vrs2=$(sed -n '1 p' /tmp/att 2>/dev/null | sed -e 's/[^0-9]//g' || echo "100")

if [[ "$vrs1" == "$vrs2" ]]; then
    echo -e "\n${CLR_GREEN}[✓] Axiom VPS Manager is up to date (Version $vrs1).${CLR_RESET}\n"
    rm -f /tmp/att > /dev/null 2>&1 || true
    read -r -p "Press Enter to return..."
    exit 0
fi

echo -e "\n${CLR_CYAN}⚡ A new Axiom update is available! (Current: $vrs1 -> New: $vrs2)${CLR_RESET}\n"
echo -e "${CLR_WHITE}Release Notes / Version Details:${CLR_RESET}"
while read -r linha; do
    echo -e "  - ${CLR_YELLOW}$linha${CLR_RESET}"
done < "/tmp/att"
echo ""

read -r -p "Do you want to update now? [y/N]: " res
if [[ "$res" =~ ^[yYsS]$ ]]; then
    echo -e "\n${CLR_GREEN}[*] Downloading and applying latest Axiom update...${CLR_RESET}\n"
    tmp_install=$(mktemp)
    if curl -fsSL https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/install.sh -o "$tmp_install"; then
        bash "$tmp_install"
        rm -f "$tmp_install" /tmp/att
        echo -e "\n${CLR_GREEN}[✓] Axiom VPS Manager updated successfully!${CLR_RESET}\n"
    else
        echo -e "\n${CLR_RED}[!] Update download failed.${CLR_RESET}\n"
    fi
else
    echo -e "\n${CLR_YELLOW}Update postponed.${CLR_RESET}\n"
fi

rm -f /tmp/att > /dev/null 2>&1 || true
read -r -p "Press Enter to return..."
