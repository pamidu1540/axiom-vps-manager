#!/usr/bin/env bash
set -euo pipefail

payload=""
if [[ -d "/etc/squid/" ]]; then
    payload="/etc/squid/payload.txt"
elif [[ -d "/etc/squid3/" ]]; then
    payload="/etc/squid3/payload.txt"
fi

tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-10s\n' "Remove Host from Squid Proxy" ; tput sgr0

if [[ -z "$payload" || ! -f "$payload" ]]; then
    echo -e "\n\033[1;31m[!] Payload file not found in /etc/squid/ or /etc/squid3/\033[0m\n"
    exit 1
fi

echo -e "\n\033[1;32mCurrent domains in $payload:\033[0m"
cat "$payload"
echo ""

read -r -p "Enter the domain to remove: " host
if [[ -z "$host" ]]; then
    echo -e "\n\033[1;31m[!] Empty domain provided.\033[0m\n"
    exit 1
fi

if ! grep -Fxq "$host" "$payload"; then
    echo -e "\n\033[1;33m[!] Domain $host not found in $payload\033[0m\n"
    exit 0
fi

tmp_file=$(mktemp)
grep -Fxv "$host" "$payload" | grep -v "^$" > "$tmp_file" || true
chmod --reference="$payload" "$tmp_file" 2>/dev/null || chmod 644 "$tmp_file"
chown --reference="$payload" "$tmp_file" 2>/dev/null || true
mv "$tmp_file" "$payload"
chmod 644 "$payload" 2>/dev/null || true

# Corrected service reload check
if systemctl is-active --quiet squid 2>/dev/null; then
    systemctl reload squid
elif systemctl is-active --quiet squid3 2>/dev/null; then
    systemctl reload squid3
elif [[ -f "/etc/init.d/squid" ]]; then
    service squid reload
elif [[ -f "/etc/init.d/squid3" ]]; then
    service squid3 reload
fi

echo -e "\n\033[1;32m[✓] Domain $host removed and proxy reloaded.\033[0m\n"
