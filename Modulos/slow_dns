#!/usr/bin/env bash
set -euo pipefail

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
CORTITLE='\033[1;44m'
DIR='/etc/VPSManager/dns'
SCOLOR='\033[0m'

clear
echo -e "${CORTITLE}        Axiom SlowDNS Manager        ${SCOLOR}\n"

installslowdns() {
    echo -e "${YELLOW}SlowDNS tunnels SSH/SSL traffic over DNS UDP queries.${SCOLOR}\n"
    read -r -p "Do you want to proceed with setup? [y/N]: " resp
    if [[ ! "$resp" =~ ^[yY]$ ]]; then
        echo -e "\n${RED}Cancelled.${SCOLOR}"
        return 0
    fi

    mkdir -p "$DIR"
    if [[ ! -f "$DIR/dns-server" ]]; then
        if [[ -f "/opt/axiom/Modulos/dns-server" ]]; then
            cp "/opt/axiom/Modulos/dns-server" "$DIR/dns-server"
        elif [[ -f "Modulos/dns-server" ]]; then
            cp "Modulos/dns-server" "$DIR/dns-server"
        elif [[ -f "Install/dns-server" ]]; then
            cp "Install/dns-server" "$DIR/dns-server"
        else
            curl -sSL -o "$DIR/dns-server" https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/Modulos/dns-server || true
        fi
        chmod 755 "$DIR/dns-server" 2>/dev/null || true
    fi

    if [[ -x "$DIR/dns-server" && (! -f "$DIR/server.key" || ! -f "$DIR/server.pub") ]]; then
        "$DIR/dns-server" -gen-key -privkey-file "$DIR/server.key" -pubkey-file "$DIR/server.pub" >/dev/null 2>&1 || true
    fi

    # Configure DNS redirection safely
    local interface
    interface=$(ip -4 route show default 2>/dev/null | awk '{print $5}' | head -n1 || echo "")
    if [[ -n "$interface" ]]; then
        # Use specific port forwarding without wiping iptables
        iptables -C INPUT -p udp --dport 5300 -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport 5300 -j ACCEPT
        iptables -t nat -C PREROUTING -i "$interface" -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null || iptables -t nat -I PREROUTING -i "$interface" -p udp --dport 53 -j REDIRECT --to-ports 5300
    fi

    # Safely modify resolved.conf without wiping other settings
    if [[ -f /etc/systemd/resolved.conf ]]; then
        if grep -qE '^#?DNSStubListener=' /etc/systemd/resolved.conf; then
            sed -i -E 's/^#?DNSStubListener=.*/DNSStubListener=no/' /etc/systemd/resolved.conf
        else
            echo "DNSStubListener=no" >> /etc/systemd/resolved.conf
        fi
        systemctl restart systemd-resolved 2>/dev/null || true
    fi
}

initslow() {
    if pgrep -f "dns-server -udp :5300" >/dev/null; then
        pkill -f "dns-server -udp :5300" || true
        echo -e "\n${RED}SlowDNS Service Stopped.${SCOLOR}"
    else
        read -r -p "Enter your NameServer domain (NS record): " ns
        [[ -z "$ns" ]] && { echo -e "${RED}Invalid domain.${SCOLOR}"; return 1; }

        echo -e "\n[1] Forward to SSH (Port 22)\n[2] Forward to SSL (Port 443)"
        read -r -p "Select target port [1-2]: " opcc
        ptdns="22"
        [[ "$opcc" == "2" ]] && ptdns="443"

        if [[ ! -f "$DIR/server.key" ]]; then
            installslowdns
        fi

        nohup "$DIR/dns-server" -udp :5300 -privkey-file "$DIR/server.key" "$ns" "127.0.0.1:$ptdns" > /var/log/slowdns.log 2>&1 &
        
        pub_key=""
        [[ -f "$DIR/server.pub" ]] && pub_key=$(cat "$DIR/server.pub")
        
        echo -e "\n${GREEN}[✓] SlowDNS Service Started on UDP :5300!${SCOLOR}"
        echo -e "${YELLOW}Server Public Key:${SCOLOR} ${pub_key}"
        echo -e "${YELLOW}Client Command:${SCOLOR} slowdns ${ns} ${pub_key}\n"
    fi
}

if [[ -d "$DIR" && -f "$DIR/server.key" ]]; then
    initslow
else
    installslowdns
    initslow
fi
