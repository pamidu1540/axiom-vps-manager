#!/usr/bin/env bash
# Axiom VPS Manager — Root Password Updater
set -euo pipefail

clear
echo -e "\033[1;36m====================================================\033[0m"
echo -e "\033[1;33m         ⚡ Axiom - Change Root Password ⚡         \033[0m"
echo -e "\033[1;36m====================================================\033[0m\n"

read -r -s -p "Enter new root password (min 8 chars): " pass1
echo ""
read -r -s -p "Confirm new root password: " pass2
echo ""

if [[ "$pass1" != "$pass2" ]]; then
    echo -e "\n\033[1;31m[!] Passwords do not match.\033[0m\n"
    exit 1
fi

if [[ ${#pass1} -lt 8 ]]; then
    echo -e "\n\033[1;31m[!] Password must be at least 8 characters.\033[0m\n"
    exit 1
fi

echo "root:$pass1" | chpasswd
echo -e "\n\033[1;32m[✓] Root password updated successfully.\033[0m\n"
read -r -p "Press Enter to return to menu..."
