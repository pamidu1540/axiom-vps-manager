#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Root Password Updater
# ==============================================================================

clear
echo -e "\033[1;36m====================================================\033[0m"
echo -e "\033[1;33m         ⚡ Axiom - Change Root Password ⚡         \033[0m"
echo -e "\033[1;36m====================================================\033[0m\n"

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[!] Error: Root password changes require root privileges.\033[0m\n"
    read -r -p "Press Enter to return..."
    exit 0
fi

while true; do
    read -r -s -p "Enter new root password (or press Enter to cancel): " pass1
    echo ""
    if [[ -z "$pass1" ]]; then
        echo -e "\n\033[1;33m[*] Operation cancelled. Returning to menu...\033[0m\n"
        sleep 1
        exit 0
    fi

    if [[ ${#pass1} -lt 8 ]]; then
        echo -e "\n\033[1;31m[!] Password must be at least 8 characters long. Please try again.\033[0m\n"
        continue
    fi

    read -r -s -p "Confirm new root password: " pass2
    echo ""

    if [[ "$pass1" != "$pass2" ]]; then
        echo -e "\n\033[1;31m[!] Passwords do not match. Please try again.\033[0m\n"
        continue
    fi

    break
done

if echo "root:$pass1" | chpasswd 2>/dev/null; then
    echo -e "\n\033[1;32m[✓] Root password updated successfully.\033[0m\n"
else
    echo -e "\n\033[1;31m[!] Failed to update root password via chpasswd.\033[0m\n"
fi

read -r -p "⚡ Press [ENTER] to return to menu..."
exit 0
