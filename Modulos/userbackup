#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Secure Backup & Recovery
# ==============================================================================

set -euo pipefail

BACKUP_DIR="/root/backups"
mkdir -p -m 700 "$BACKUP_DIR" 2>/dev/null || true

opt="${1:-}"

if [[ -z "$opt" ]]; then
    if [[ -t 0 ]]; then
        clear
        echo -e "\033[1;36m====================================================\033[0m"
        echo -e "\033[1;33m       ⚡ Axiom VPS Manager — Secure Backup ⚡       \033[0m"
        echo -e "\033[1;36m====================================================\033[0m"
        echo ""
        echo -e "\033[1;32m[1]\033[0m Create System & User Archive Backup"
        echo -e "\033[1;32m[2]\033[0m Restore System from Backup Archive"
        echo -e "\033[1;32m[3]\033[0m List Existing Backups"
        echo -e "\033[1;31m[0]\033[0m Return to Menu"
        echo ""
        read -r -p "Select an option [0-3]: " opt
    else
        opt="1"
    fi
fi

case "$opt" in
    1)
        TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
        BACKUP_FILE="$BACKUP_DIR/axiom_backup_${TIMESTAMP}.tar.gz"
        TMP_DIR=$(mktemp -d)
        
        echo -e "\n\033[1;33m[*] Collecting configurations and user database...\033[0m"
        
        # Include necessary configs without exposing plaintext passwords
        [[ -f /root/usuarios.db ]] && cp /root/usuarios.db "$TMP_DIR/"
        [[ -d /etc/VPSManager ]] && cp -r /etc/VPSManager "$TMP_DIR/"
        [[ -d /etc/wireguard ]] && cp -r /etc/wireguard "$TMP_DIR/" 2>/dev/null || true
        [[ -d /etc/axiom ]] && cp -r /etc/axiom "$TMP_DIR/" 2>/dev/null || true
        [[ -d /opt/axiom/config ]] && cp -r /opt/axiom/config "$TMP_DIR/" 2>/dev/null || true
        
        # Pack securely
        tar -czf "$BACKUP_FILE" -C "$TMP_DIR" .
        chmod 600 "$BACKUP_FILE"
        rm -rf "$TMP_DIR"
        
        echo -e "\033[1;32m[✓] Backup created successfully:\033[0m $BACKUP_FILE"
        echo -e "\033[1;33m[!] Note: Backups are stored locally with root-only permissions (chmod 600).\033[0m"
        echo -e "\033[1;33m    Download securely via SFTP / SCP (e.g. scp root@<server_ip>:$BACKUP_FILE .)\033[0m\n"
        if [[ -t 0 && -z "${1:-}" ]]; then
            read -r -p "⚡ Press [ENTER] to return to menu..."
        fi
        ;;
    2)
        RESTORE_FILE="${2:-}"
        if [[ -z "$RESTORE_FILE" ]]; then
            mapfile -t b_list < <(find "$BACKUP_DIR" -maxdepth 1 -name "*.tar.gz" | sort -r)
            if [[ ${#b_list[@]} -eq 0 ]]; then
                echo -e "\n\033[1;31m[!] No backups found in $BACKUP_DIR\033[0m\n"
                read -r -p "⚡ Press [ENTER] to return..."
                exit 0
            fi

            echo -e "\n\033[1;33mAvailable backups:\033[0m"
            for i in "${!b_list[@]}"; do
                idx=$((i + 1))
                b_name=$(basename "${b_list[$i]}")
                b_sz=$(du -h "${b_list[$i]}" | cut -f1)
                echo -e "[\033[1;32m$idx\033[0m] $b_name (\033[1;36m$b_sz\033[0m)"
            done
            echo ""
            read -r -p "Enter backup number or path: " b_sel

            if [[ "$b_sel" =~ ^[0-9]+$ ]] && (( b_sel >= 1 && b_sel <= ${#b_list[@]} )); then
                RESTORE_FILE="${b_list[$((b_sel - 1))]}"
            elif [[ -f "$b_sel" ]]; then
                RESTORE_FILE="$b_sel"
            elif [[ -f "$BACKUP_DIR/$b_sel" ]]; then
                RESTORE_FILE="$BACKUP_DIR/$b_sel"
            fi
        fi

        if [[ -n "$RESTORE_FILE" && -f "$RESTORE_FILE" ]]; then
            TMP_RESTORE=$(mktemp -d)
            tar -xzf "$RESTORE_FILE" -C "$TMP_RESTORE"
            [[ -f "$TMP_RESTORE/usuarios.db" ]] && cp "$TMP_RESTORE/usuarios.db" /root/
            [[ -d "$TMP_RESTORE/VPSManager" ]] && cp -r "$TMP_RESTORE/VPSManager" /etc/
            [[ -d "$TMP_RESTORE/wireguard" ]] && cp -r "$TMP_RESTORE/wireguard" /etc/
            [[ -d "$TMP_RESTORE/axiom" ]] && cp -r "$TMP_RESTORE/axiom" /etc/
            rm -rf "$TMP_RESTORE"
            echo -e "\n\033[1;32m[✓] Restore completed successfully from $(basename "$RESTORE_FILE").\033[0m\n"
        else
            echo -e "\n\033[1;31m[!] Invalid backup selection or file not found.\033[0m\n"
        fi
        if [[ -t 0 && -z "${1:-}" ]]; then
            read -r -p "⚡ Press [ENTER] to return..."
        fi
        ;;
    3)
        mapfile -t b_list < <(find "$BACKUP_DIR" -maxdepth 1 -name "*.tar.gz" | sort -r)
        if [[ ${#b_list[@]} -eq 0 ]]; then
            echo -e "\n\033[1;33mNo backups found in $BACKUP_DIR.\033[0m\n"
        else
            echo -e "\n\033[1;33mExisting backups in $BACKUP_DIR:\033[0m"
            for i in "${!b_list[@]}"; do
                idx=$((i + 1))
                b_name=$(basename "${b_list[$i]}")
                b_sz=$(du -h "${b_list[$i]}" | cut -f1)
                echo -e "[\033[1;32m$idx\033[0m] $b_name (\033[1;36m$b_sz\033[0m)"
            done
            echo ""
        fi
        if [[ -t 0 && -z "${1:-}" ]]; then
            read -r -p "⚡ Press [ENTER] to return..."
        fi
        ;;
    *)
        exit 0
        ;;
esac
