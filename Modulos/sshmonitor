#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Active SSH & VPN User Monitor
# ==============================================================================

# Source common library
LIB_PATH="/etc/axiom/lib/axiom-common.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    LIB_PATH="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/lib/axiom-common.sh"
fi
if [[ -f "$LIB_PATH" ]]; then
    # shellcheck source=lib/axiom-common.sh
    source "$LIB_PATH"
fi

if type axiom_require_root >/dev/null 2>&1; then
    axiom_require_root
elif [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[!] Error: Axiom operations require root privileges.\033[0m" >&2
    read -r -p "⚡ Press [ENTER] to return..."
    exit 1
fi

database="/root/usuarios.db"
touch "$database" 2>/dev/null || true

clear
echo -e "\E[44;1;37m Username          Status       Active/Limit   Session Time  \E[0m\n"

user_count=0

if [[ -f "$database" ]]; then
    while read -r usline; do
        [[ -z "$usline" ]] && continue
        if ! [[ "$usline" =~ ^[a-zA-Z0-9_-]+[[:space:]]+[0-9]+ ]]; then
            continue
        fi

        user=$(echo "$usline" | awk '{print $1}')
        limit=$(echo "$usline" | awk '{print $2}')
        [[ -z "$limit" ]] && limit="1"

        if ! id "$user" >/dev/null 2>&1; then
            continue
        fi

        user_count=$((user_count + 1))

        # Count SSH sessions safely
        ssh_conns=$(pgrep -c -u "$user" sshd 2>/dev/null || true)
        ssh_conns=$(echo "$ssh_conns" | tr -dc '0-9'); [[ -z "$ssh_conns" ]] && ssh_conns=0

        drop_conns=$(pgrep -c -u "$user" dropbear 2>/dev/null || true)
        drop_conns=$(echo "$drop_conns" | tr -dc '0-9'); [[ -z "$drop_conns" ]] && drop_conns=0

        ovp_conns=0
        if [[ -f /etc/openvpn/openvpn-status.log ]]; then
            ovp_conns=$(grep -E -c ",${user}," /etc/openvpn/openvpn-status.log 2>/dev/null || true)
            ovp_conns=$(echo "$ovp_conns" | tr -dc '0-9'); [[ -z "$ovp_conns" ]] && ovp_conns=0
        fi

        total_conns=$((ssh_conns + drop_conns + ovp_conns))

        # Elapsed session time
        session_time="--:--:--"
        if (( total_conns > 0 )); then
            first_pid=$(pgrep -u "$user" sshd 2>/dev/null | head -n1 || true)
            if [[ -z "$first_pid" ]]; then
                first_pid=$(pgrep -u "$user" dropbear 2>/dev/null | head -n1 || true)
            fi
            if [[ -n "$first_pid" ]]; then
                session_time=$(ps -p "$first_pid" -o etime= 2>/dev/null | xargs || echo "00:00:00")
            else
                session_time="Active"
            fi
            status_fmt="\033[1;32mOnline \033[0m"
        else
            status_fmt="\033[1;31mOffline\033[0m"
        fi

        printf ' \033[1;37m%-17s\033[0m %-20b \033[1;36m%-14s\033[0m \033[1;33m%s\033[0m\n' \
            "$user" "$status_fmt" "$total_conns/$limit" "$session_time"
        echo -e "\033[0;34m─────────────────────────────────────────────────────────────\033[0m"
    done < "$database"
fi

if [[ $user_count -eq 0 ]]; then
    echo -e "  \033[1;33mNo managed users registered in system.\033[0m\n"
fi

echo ""
read -r -p "⚡ Press [ENTER] to return to menu..."
exit 0
