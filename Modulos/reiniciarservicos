#!/usr/bin/env bash
# Axiom VPS Manager — Service Restart Manager
set -euo pipefail

clear
echo -e "\033[1;36m====================================================\033[0m"
echo -e "\033[1;33m          ⚡ Axiom Service Restart Manager ⚡       \033[0m"
echo -e "\033[1;36m====================================================\033[0m\n"

restart_svc() {
    local name="$1"
    local svc="$2"
    if systemctl is-active --quiet "$svc" 2>/dev/null || systemctl is-enabled --quiet "$svc" 2>/dev/null; then
        echo -ne "\033[1;33m[*] Restarting $name ($svc)... \033[0m"
        systemctl restart "$svc" 2>/dev/null || true
        echo -e "\033[1;32m[OK]\033[0m"
    fi
}

restart_svc "OpenSSH Server" "sshd"
restart_svc "OpenSSH Server" "ssh"
restart_svc "Axiom WebSocket Proxy" "axiom-wsproxy"
restart_svc "Axiom Telegram Bot" "axiom-bot"
restart_svc "Caddy Web Server" "caddy"
restart_svc "WireGuard VPN" "wg-quick@wg0"
restart_svc "Xray Engine" "xray"
restart_svc "Hysteria 2" "hysteria-server"
restart_svc "Squid Proxy" "squid"
restart_svc "Squid Proxy" "squid3"
restart_svc "Dropbear SSH" "dropbear"
restart_svc "OpenVPN Server" "openvpn"
restart_svc "Stunnel4 TLS" "stunnel4"

echo -e "\n\033[1;32m[✓] All active services restarted successfully.\033[0m\n"
read -r -p "Press Enter to return to menu..."
