#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Auto-Execution Toggle Module
# Automatically launches Axiom dashboard on root SSH login.
# ==============================================================================

set -euo pipefail

CLR_RESET='\033[0m'
CLR_RED='\033[1;31m'
CLR_GREEN='\033[1;32m'
CLR_YELLOW='\033[1;33m'
CLR_CYAN='\033[1;36m'
CLR_BOLD='\033[1m'

clear
echo -e "${CLR_CYAN}====================================================${CLR_RESET}"
echo -e "${CLR_YELLOW}${CLR_BOLD}       ⚡ Axiom Auto-Execution on Login Toggle ⚡      ${CLR_RESET}"
echo -e "${CLR_CYAN}====================================================${CLR_RESET}\n"

if grep -q "axiom;" /etc/profile 2>/dev/null || grep -q "menu;" /etc/profile 2>/dev/null; then
    echo -e "Current Status: ${CLR_GREEN}${CLR_BOLD}● ACTIVE${CLR_RESET} (Axiom runs on SSH login)\n"
    read -r -p "Do you want to DISABLE auto-execution? [y/N]: " resp
    if [[ "$resp" =~ ^[yY]$ ]]; then
        sed -i '/menu;/d' /etc/profile 2>/dev/null || true
        sed -i '/axiom;/d' /etc/profile 2>/dev/null || true
        echo -e "\n${CLR_RED}[✓] Auto-execution on login DISABLED.${CLR_RESET}\n"
    else
        echo -e "\n${CLR_YELLOW}No changes made.${CLR_RESET}\n"
    fi
else
    echo -e "Current Status: ${CLR_RED}${CLR_BOLD}○ INACTIVE${CLR_RESET}\n"
    read -r -p "Do you want to ENABLE auto-execution on login? [y/N]: " resp
    if [[ "$resp" =~ ^[yY]$ ]]; then
        sed -i '/menu;/d' /etc/profile 2>/dev/null || true
        sed -i '/axiom;/d' /etc/profile 2>/dev/null || true
        echo "axiom;" >> /etc/profile
        echo -e "\n${CLR_GREEN}[✓] Auto-execution on login ENABLED.${CLR_RESET}\n"
    else
        echo -e "\n${CLR_YELLOW}No changes made.${CLR_RESET}\n"
    fi
fi

if [[ -t 0 ]]; then
    read -r -p "Press Enter to return..."
fi
