#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Advanced Operations Menu Direct Entrypoint
# ==============================================================================

REAL_SOURCE="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || echo "${BASH_SOURCE[0]:-$0}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SOURCE")" 2>/dev/null && pwd || echo "")"
MENU_SCRIPT="$SCRIPT_DIR/menu"

if [[ ! -f "$MENU_SCRIPT" ]]; then
    MENU_SCRIPT="/opt/axiom/Modulos/menu"
fi

if [[ -f "$MENU_SCRIPT" ]]; then
    exec bash "$MENU_SCRIPT" menu2 "$@"
else
    echo "Error: Axiom menu script not found." >&2
    exit 1
fi
