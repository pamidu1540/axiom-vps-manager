#!/usr/bin/env bash
# Axiom VPS Manager — System & Port Diagnostics
set -euo pipefail

if [[ -t 0 ]]; then
    clear
fi
echo -e "\E[44;1;37m               ⚡ Axiom VPS Diagnostics & Information ⚡                 \E[0m\n"

# 1. Operating System Information
echo -e "\033[1;31m• \033[1;32mOPERATING SYSTEM\033[1;31m •\033[0m\n"
if [[ -f /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    echo -e "\033[1;33mDistribution:\033[1;37m ${PRETTY_NAME:-Linux}"
    echo -e "\033[1;33mKernel:\033[1;37m $(uname -s)"
    echo -e "\033[1;33mKernel Release:\033[1;37m $(uname -r)"
elif [[ -f /etc/issue.net ]]; then
    echo -e "\033[1;33mVersion:\033[1;37m $(cat /etc/issue.net)"
fi
echo ""

# 2. Processor Information
echo -e "\033[1;31m• \033[1;32mPROCESSOR & ARCHITECTURE\033[1;31m •\033[0m\n"
if [[ -f /proc/cpuinfo ]]; then
    modelo=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -n1 | cut -d: -f2 | sed 's/^[ \t]*//' || echo "Generic CPU")
    cpucores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo "1")
    echo -e "\033[1;33mModel:\033[1;37m $modelo"
    echo -e "\033[1;33mCPU Cores:\033[1;37m $cpucores"
    echo -e "\033[1;33mArchitecture:\033[1;37m $(uname -m)"
else
    echo -e "\033[1;33mArchitecture:\033[1;37m $(uname -m)"
fi
echo ""

# 3. RAM & Memory Usage
echo -e "\033[1;31m• \033[1;32mRAM & MEMORY USAGE\033[1;31m •\033[0m\n"
if command -v free >/dev/null 2>&1; then
    ram_total=$(free -h | awk '/Mem:/ {print $2}')
    ram_used=$(free -h | awk '/Mem:/ {print $3}')
    ram_free=$(free -h | awk '/Mem:/ {print $4}')
    ram_pct=$(free -m | awk '/Mem:/ {printf "%.1f%%", $3*100/$2}')
    echo -e "\033[1;33mTotal RAM:\033[1;37m $ram_total"
    echo -e "\033[1;33mIn Use:\033[1;37m $ram_used ($ram_pct)"
    echo -e "\033[1;33mFree / Available:\033[1;37m $ram_free"
else
    echo "Unable to retrieve memory information."
fi
echo ""

# 4. Active Listening Ports (TCP & UDP)
echo -e "\033[1;31m• \033[1;32mACTIVE LISTENING PORTS (TCP & UDP)\033[1;31m •\033[0m\n"
if command -v ss >/dev/null 2>&1; then
    ss -tulpn 2>/dev/null | awk 'NR>1 {printf "  %-6s %-25s %s\n", $1, $5, $7}' || true
elif command -v lsof >/dev/null 2>&1; then
    lsof -V -i -P -n 2>/dev/null | grep LISTEN || true
else
    netstat -tulpn 2>/dev/null || true
fi
echo ""

if [[ -t 0 ]]; then
    read -r -p "Press Enter to return to menu..."
fi
