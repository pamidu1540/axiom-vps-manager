#!/usr/bin/env bash
# Axiom VPS Manager — SlowDNS Client
set -euo pipefail

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CORTITLE='\033[1;41m'
SCOLOR='\033[0m'

banner='
 ___ _    _____      _____  _  _ ___ 
/ __| |  / _ \ \    / /   \| \| / __|
\__ \ |_| (_) \ \/\/ /| |) | .  \__ \
|___/____\___/ \_/\_/ |___/|_|\_|___/'

clear
echo -e "${CORTITLE}◇───────────────────────────────────────────────◇${SCOLOR}" 
echo -e "${CORTITLE}⚡ㅤAXIOM VPS MANAGER SLOW DNS CLIENTㅤ⚡${SCOLOR}"
echo -e "${CORTITLE}◇───────────────────────────────────────────────◇${SCOLOR}" 
echo -e "${RED}$banner${SCOLOR}\n"

if [[ ! -e "$HOME/dns" ]]; then
    if [[ -f "/opt/axiom/Modulos/dns" ]]; then
        cp "/opt/axiom/Modulos/dns" "$HOME/dns"
    elif [[ -f "Modulos/dns" ]]; then
        cp "Modulos/dns" "$HOME/dns"
    else
        echo -e "${GREEN}[*] Downloading DNS client binary...${SCOLOR}"
        curl -sSL -o "$HOME/dns" https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/Modulos/dns > /dev/null 2>&1 || true
    fi
    chmod +x "$HOME/dns" 2>/dev/null || true
fi

if [[ ! -e "$HOME/credenciais" ]]; then
    ns="${1:-}"
    if [[ -z "$ns" ]]; then
        echo -e "${RED}[!] Missing NameServer domain (arg 1)${SCOLOR}"
        exit 1
    fi
    chave="${2:-}"
    if [[ -z "$chave" ]]; then
        echo -e "${RED}[!] Missing server public key (arg 2)${SCOLOR}"
        exit 1
    fi
    echo -e "$ns\n$chave" > "$HOME/credenciais"
else
    echo -e "${YELLOW}Existing SlowDNS credentials found.${SCOLOR}"
    read -r -p "Do you want to continue with existing configuration? [Y/n]: " opc
    if [[ "$opc" =~ ^[nN]$ ]]; then
        rm -f "$HOME/credenciais" "$HOME/dns" > /dev/null 2>&1 || true
        echo -e "${RED}[✓] Configuration removed.${SCOLOR}"
        exit 0
    else
        ns=$(sed -n 1p "$HOME/credenciais")
        chave=$(sed -n 2p "$HOME/credenciais")
    fi
fi

dns="${3:-}"
if [[ -z "$dns" ]]; then
    # Dynamically extract default nameserver from resolv.conf, fallback to 8.8.8.8
    dns=$(grep -E '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | head -n1 || echo "8.8.8.8")
fi

echo -e "\n${YELLOW}[*] Target DNS Server: ${GREEN}$dns${SCOLOR}"
echo -e "${YELLOW}[*] NameServer Domain: ${GREEN}$ns${SCOLOR}"
read -r -p "Press Enter to establish SlowDNS tunnel..."

"$HOME/dns" -udp "${dns}:53" -pubkey "${chave}" "${ns}" 127.0.0.1:2222 > /dev/null 2>&1 &
tunnel_pid=$!

echo -e "\n${GREEN}[✓] SlowDNS Client Started (PID: $tunnel_pid)!${SCOLOR}"
echo -e "${YELLOW}[*] Connect your VPN application to 127.0.0.1:2222 or press Enter to stop.${SCOLOR}"
read -r -p ""

kill "$tunnel_pid" 2>/dev/null || true
piddns=$(pgrep -f "$HOME/dns -udp" 2>/dev/null || true)
if [[ -n "$piddns" ]]; then
    kill $piddns > /dev/null 2>&1 || true
fi
echo -e "\n${RED}[✓] SlowDNS Client Stopped.${SCOLOR}"
