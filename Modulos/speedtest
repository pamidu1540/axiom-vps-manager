#!/usr/bin/env bash
# Axiom VPS Manager — High-Performance Speedtest Benchmark
set -euo pipefail

export PATH="/opt/axiom/Modulos:/usr/local/bin:/usr/bin:/bin:$PATH"

CLR_RESET='\033[0m'
CLR_RED='\033[1;31m'
CLR_GREEN='\033[1;32m'
CLR_YELLOW='\033[1;33m'
CLR_BLUE='\033[1;34m'
CLR_CYAN='\033[1;36m'
CLR_BOLD='\033[1m'

if [[ -t 0 && "${1:-}" != "--simple" && "${1:-}" != "--non-interactive" ]]; then
    clear
    echo -e "${CLR_CYAN}◇───────────────────────────────────────────────◇${CLR_RESET}"
    echo -e "${CLR_YELLOW}${CLR_BOLD}         ⚡ Axiom Speedtest Benchmark ⚡         ${CLR_RESET}"
    echo -e "${CLR_CYAN}◇───────────────────────────────────────────────◇${CLR_RESET}\n"
fi

run_cloudflare_benchmark() {
    echo -e "${CLR_BLUE}[*] Running Built-in Cloudflare High-Speed CDN Benchmark...${CLR_RESET}"

    # 1. Latency / Ping
    echo -ne "  ${CLR_YELLOW}Measuring Latency...${CLR_RESET} "
    local ping_val="N/A"
    if command -v ping >/dev/null 2>&1; then
        local ping_raw
        ping_raw=$(ping -c 4 -W 2 1.1.1.1 2>/dev/null | tail -1 | awk -F '/' '{print $5}' || echo "")
        if [[ -n "$ping_raw" ]]; then
            ping_val="${ping_raw} ms"
        fi
    fi
    if [[ "$ping_val" == "N/A" ]] && command -v curl >/dev/null 2>&1; then
        local time_total
        time_total=$(curl -s -w "%{time_total}\n" -o /dev/null --connect-timeout 3 https://1.1.1.1 2>/dev/null || echo "0")
        if awk "BEGIN {exit !($time_total > 0)}" 2>/dev/null; then
            ping_val=$(awk "BEGIN {printf \"%.1f ms\", $time_total * 1000}")
        fi
    fi
    echo -e "${CLR_GREEN}${ping_val}${CLR_RESET}"

    # 2. Download Speed (25 MB test payload)
    echo -ne "  ${CLR_YELLOW}Testing Download Speed (25MB)...${CLR_RESET} "
    local dl_speed_bytes="0"
    if command -v curl >/dev/null 2>&1; then
        dl_speed_bytes=$(curl -4 -sk --max-time 15 -w "%{speed_download}" -o /dev/null "https://speed.cloudflare.com/__down?bytes=25000000" 2>/dev/null || echo "0")
    elif command -v wget >/dev/null 2>&1; then
        local tmp_file
        tmp_file=$(mktemp)
        local start_t end_t
        start_t=$(date +%s%N 2>/dev/null || date +%s)
        wget -q -O "$tmp_file" --timeout=15 "https://speed.cloudflare.com/__down?bytes=25000000" 2>/dev/null || true
        end_t=$(date +%s%N 2>/dev/null || date +%s)
        local file_sz
        file_sz=$(stat -c%s "$tmp_file" 2>/dev/null || echo "0")
        rm -f "$tmp_file"
        local diff_s=$(( (end_t - start_t) / 1000000000 ))
        [[ $diff_s -lt 1 ]] && diff_s=1
        dl_speed_bytes=$(( file_sz / diff_s ))
    fi

    local dl_mbps="0.00"
    if [[ -n "$dl_speed_bytes" && "$dl_speed_bytes" != "0" ]]; then
        dl_mbps=$(awk "BEGIN {printf \"%.2f\", ($dl_speed_bytes * 8) / 1000000}")
    fi
    echo -e "${CLR_GREEN}${dl_mbps} Mbps${CLR_RESET}"

    # 3. Upload Speed (5 MB test payload)
    echo -ne "  ${CLR_YELLOW}Testing Upload Speed (5MB)...${CLR_RESET} "
    local up_mbps="0.00"
    if command -v curl >/dev/null 2>&1; then
        local tmp_up
        tmp_up=$(mktemp)
        dd if=/dev/urandom of="$tmp_up" bs=1M count=5 2>/dev/null || truncate -s 5M "$tmp_up" 2>/dev/null || true
        local up_speed_bytes
        up_speed_bytes=$(curl -4 -sk --max-time 15 -w "%{speed_upload}" -o /dev/null --data-binary @"$tmp_up" "https://speed.cloudflare.com/__up" 2>/dev/null || echo "0")
        rm -f "$tmp_up"
        if [[ -n "$up_speed_bytes" && "$up_speed_bytes" != "0" ]]; then
            up_mbps=$(awk "BEGIN {printf \"%.2f\", ($up_speed_bytes * 8) / 1000000}")
        fi
    fi
    echo -e "${CLR_GREEN}${up_mbps} Mbps${CLR_RESET}"

    echo -e "\n${CLR_CYAN}◇───────────────────────────────────────────────◇${CLR_RESET}"
    echo -e "${CLR_BOLD}  Latency  :${CLR_RESET} ${CLR_GREEN}${ping_val}${CLR_RESET}"
    echo -e "${CLR_BOLD}  Download :${CLR_RESET} ${CLR_GREEN}${dl_mbps} Mbps${CLR_RESET}"
    echo -e "${CLR_BOLD}  Upload   :${CLR_RESET} ${CLR_GREEN}${up_mbps} Mbps${CLR_RESET}"
    echo -e "${CLR_CYAN}◇───────────────────────────────────────────────◇${CLR_RESET}"
}

# Main speedtest execution flow
executed=false

# 1. Try Ookla Official CLI (speedtest)
if command -v speedtest >/dev/null 2>&1; then
    echo -e "${CLR_BLUE}[*] Running Ookla Speedtest...${CLR_RESET}"
    if speedtest --accept-license --accept-gdpr 2>/dev/null; then
        executed=true
    fi
fi

# 2. Try Python speedtest-cli with --secure
if [[ "$executed" == false ]]; then
    if ! command -v speedtest-cli >/dev/null 2>&1; then
        echo -e "${CLR_BLUE}[*] Installing speedtest-cli utility...${CLR_RESET}"
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -y >/dev/null 2>&1 || true
        apt-get install -y speedtest-cli >/dev/null 2>&1 || pip3 install --break-system-packages speedtest-cli >/dev/null 2>&1 || pip install speedtest-cli >/dev/null 2>&1 || true
    fi

    if command -v speedtest-cli >/dev/null 2>&1; then
        echo -e "${CLR_BLUE}[*] Running speedtest-cli (secure HTTPS mode)...${CLR_RESET}"
        if [[ "${1:-}" == "--simple" ]]; then
            if speedtest-cli --secure --simple 2>/dev/null; then
                executed=true
            fi
        else
            if speedtest-cli --secure 2>/dev/null || speedtest-cli --secure --simple 2>/dev/null; then
                executed=true
            fi
        fi
    fi
fi

# 3. Fallback to Cloudflare CDN speedtest benchmark if external tools fail
if [[ "$executed" == false ]]; then
    run_cloudflare_benchmark
fi

if [[ -t 0 && "${1:-}" != "--simple" && "${1:-}" != "--non-interactive" ]]; then
    echo ""
    read -r -p "Press Enter to return to menu..."
fi