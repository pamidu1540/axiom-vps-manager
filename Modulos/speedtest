#!/usr/bin/env bash
# Axiom VPS Manager — Speedtest Network Benchmark
set -euo pipefail

if [[ -t 0 && "${1:-}" != "--simple" && "${1:-}" != "--non-interactive" ]]; then
    clear
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e "\033[1;33m          ⚡ Axiom Speedtest Benchmark ⚡           \033[0m"
    echo -e "\033[1;36m====================================================\033[0m\n"
fi

if ! command -v speedtest-cli >/dev/null 2>&1 && ! command -v speedtest >/dev/null 2>&1; then
    echo -e "\033[1;33m[*] Installing speedtest-cli...\033[0m"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null 2>&1 || true
    apt-get install -y speedtest-cli >/dev/null 2>&1 || pip install speedtest-cli >/dev/null 2>&1 || true
fi

if command -v speedtest-cli >/dev/null 2>&1; then
    if [[ "${1:-}" == "--simple" ]]; then
        speedtest-cli --simple || speedtest-cli || true
    else
        speedtest-cli --share 2>/dev/null || speedtest-cli || true
    fi
elif command -v speedtest >/dev/null 2>&1; then
    speedtest || true
else
    echo -e "\033[1;31m[!] Speedtest utility could not be installed.\033[0m"
fi

if [[ -t 0 && "${1:-}" != "--simple" && "${1:-}" != "--non-interactive" ]]; then
    echo -e "\n\033[1;36m====================================================\033[0m"
    read -r -p "Press Enter to return to menu..."
fi