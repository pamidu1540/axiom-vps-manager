#!/usr/bin/env bash
# ==============================================================================
# Axiom VPS Manager — Change Account Expiry Date Module
# ==============================================================================


# Source common library
LIB_PATH="/etc/axiom/lib/axiom-common.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
    LIB_PATH="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/lib/axiom-common.sh"
fi
if [[ -f "$LIB_PATH" ]]; then
    # shellcheck source=lib/axiom-common.sh
    source "$LIB_PATH"
fi

if type axiom_require_root >/dev/null 2>&1; then
    axiom_require_root
elif [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[!] Error: Axiom operations require root privileges.\033[0m" >&2
    read -r -p "⚡ Press [ENTER] to return..."
    exit 1
fi

database="/root/usuarios.db"
touch "$database" 2>/dev/null || true

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-10s\n' "  Axiom - Modify Account Expiry  " ; tput sgr0
echo ""

mapfile -t users_list < <(awk '{print $1}' "$database" 2>/dev/null | sort -u)
if [[ ${#users_list[@]} -eq 0 ]]; then
    mapfile -t users_list < <(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null | sort -u)
fi

if [[ ${#users_list[@]} -eq 0 ]]; then
    echo -e "\033[1;31mNo managed users found.\033[0m\n"
    read -r -p "⚡ Press [ENTER] to return..."
    exit 0
fi

echo -e "\033[1;33mManaged Users & Expiry Status:\033[0m\n"
for i in "${!users_list[@]}"; do
    idx=$((i + 1))
    u="${users_list[$i]}"
    raw_exp=$(chage -l "$u" 2>/dev/null | grep -i "Account expires" | awk -F: '{print $2}' | xargs || echo "never")
    if [[ "$raw_exp" == "never" || -z "$raw_exp" ]]; then
        status_str="\033[1;33mNever\033[0m"
    else
        exp_fmt=$(date -d "$raw_exp" "+%d/%m/%Y" 2>/dev/null || echo "$raw_exp")
        status_str="\033[1;32m$exp_fmt\033[0m"
    fi
    echo -e "[\033[1;32m$idx\033[0m] \033[1;37m$u\033[0m — Expires: $status_str"
done
echo ""

read -r -p "Enter user number or username (or '0' to cancel): " sel
if [[ "$sel" == "0" || "$sel" == "q" || -z "$sel" ]]; then
    exit 0
fi
target_user=""
if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#users_list[@]} )); then
    target_user="${users_list[$((sel - 1))]}"
elif id "$sel" >/dev/null 2>&1; then
    target_user="$sel"
fi

if [[ -z "$target_user" ]] || ! id "$target_user" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User not found or invalid selection.\033[0m\n"
    read -r -p "⚡ Press [ENTER] to return..."
    exit 0
fi

echo -e "\nEnter either additional days (e.g. \033[1;32m30\033[0m) or specific date (\033[1;32mYYYY-MM-DD\033[0m):"
read -r -p "New expiration: " exp_in

today_sec=$(date +%s)

if [[ "$exp_in" =~ ^[0-9]+$ ]] && [[ "$exp_in" -gt 0 ]]; then
    target_date=$(date "+%Y-%m-%d" -d "+$exp_in days")
    display_date=$(date "+%d/%m/%Y" -d "+$exp_in days")
elif [[ "$exp_in" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && date -d "$exp_in" "+%Y-%m-%d" >/dev/null 2>&1; then
    target_date=$(date -d "$exp_in" "+%Y-%m-%d")
    display_date=$(date -d "$exp_in" "+%d/%m/%Y")
    target_sec=$(date -d "$target_date" +%s)
    if (( target_sec < today_sec )); then
        echo -e "\n\033[1;33m[!] Warning: Date $target_date is in the past and will immediately expire this account.\033[0m"
        read -r -p "Proceed anyway? [y/N]: " confirm_past
        if ! [[ "$confirm_past" =~ ^[yY]$ ]]; then
            echo -e "\033[1;31mOperation cancelled.\033[0m"
            read -r -p "⚡ Press [ENTER] to return..."
            exit 0
        fi
    fi
else
    echo -e "\n\033[1;31m[!] Invalid date format. Use positive days (e.g. 30) or YYYY-MM-DD.\033[0m\n"
    read -r -p "⚡ Press [ENTER] to return..."
    exit 0
fi

chage -E "$target_date" "$target_user"

if type axiom_audit >/dev/null 2>&1; then
    axiom_audit "USER_CHANGE_EXPIRY" "$target_user" "target_date=$target_date"
fi

echo -e "\n\033[1;32m[✓] Expiration for '$target_user' updated to $display_date ($target_date).\033[0m\n"
read -r -p "⚡ Press [ENTER] to return to menu..."
