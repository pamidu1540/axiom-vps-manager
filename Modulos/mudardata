#!/usr/bin/env bash
# Axiom VPS Manager — Change Account Expiry Date Module
set -euo pipefail

database="/root/usuarios.db"
touch "$database"

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-10s\n' "  Axiom - Modify Account Expiry  " ; tput sgr0
echo ""

mapfile -t users_list < <(awk '{print $1}' "$database" | sort -u)
if [[ ${#users_list[@]} -eq 0 ]]; then
    echo -e "\033[1;31mNo managed users found.\033[0m\n"
    exit 0
fi

echo -e "\033[1;33mManaged Users & Expiry Status:\033[0m\n"
for i in "${!users_list[@]}"; do
    idx=$((i + 1))
    u="${users_list[$i]}"
    raw_exp=$(chage -l "$u" 2>/dev/null | grep -i "Account expires" | awk -F: '{print $2}' | xargs || echo "never")
    if [[ "$raw_exp" == "never" || -z "$raw_exp" ]]; then
        status_str="\033[1;33mNever\033[0m"
    else
        exp_fmt=$(date -d "$raw_exp" "+%d/%m/%Y" 2>/dev/null || echo "$raw_exp")
        status_str="\033[1;32m$exp_fmt\033[0m"
    fi
    echo -e "[\033[1;32m$idx\033[0m] \033[1;37m$u\033[0m — Expires: $status_str"
done
echo ""

read -r -p "Enter user number or username: " sel
target_user=""
if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#users_list[@]} )); then
    target_user="${users_list[$((sel - 1))]}"
elif grep -qw "$sel" "$database"; then
    target_user="$sel"
fi

if [[ -z "$target_user" ]] || ! id "$target_user" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User not found.\033[0m\n"
    exit 1
fi

echo -e "\nEnter either additional days (e.g. \033[1;32m30\033[0m) or specific date (\033[1;32mYYYY-MM-DD\033[0m):"
read -r -p "New expiration: " exp_in

if [[ "$exp_in" =~ ^[0-9]+$ ]]; then
    target_date=$(date "+%Y-%m-%d" -d "+$exp_in days")
    display_date=$(date "+%d/%m/%Y" -d "+$exp_in days")
elif date -d "$exp_in" "+%Y-%m-%d" >/dev/null 2>&1; then
    target_date=$(date -d "$exp_in" "+%Y-%m-%d")
    display_date=$(date -d "$exp_in" "+%d/%m/%Y")
else
    echo -e "\n\033[1;31m[!] Invalid date format. Use days (e.g. 30) or YYYY-MM-DD.\033[0m\n"
    exit 1
fi

chage -E "$target_date" "$target_user"
echo -e "\n\033[1;32m[✓] Expiration for '$target_user' updated to $display_date ($target_date).\033[0m\n"
read -r -p "Press Enter to return to menu..."
