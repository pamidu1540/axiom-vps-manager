#!/usr/bin/env bash
# Axiom VPS Manager — Account Creation Module
set -euo pipefail

# Source common library
LIB_PATH="/etc/axiom/lib/axiom-common.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    LIB_PATH="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/lib/axiom-common.sh"
fi
if [[ -f "$LIB_PATH" ]]; then
    # shellcheck source=lib/axiom-common.sh
    source "$LIB_PATH"
fi

if type axiom_require_root >/dev/null 2>&1; then
    axiom_require_root
elif [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[!] Error: Axiom operations require root privileges.\033[0m" >&2
    exit 1
fi

IP=$(cat /etc/IP 2>/dev/null || curl -s -4 --connect-timeout 5 ifconfig.me || echo "127.0.0.1")
cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'

clear
echo -e "${cor2}         ⚡ Axiom - Create User Account ⚡         ${scor}\n"

read -r -p "Enter username: " username
[[ -z "$username" ]] && { echo -e "\n${cor1}Username cannot be empty.${scor}\n"; exit 1; }

if ! [[ "$username" =~ ^[a-zA-Z0-9_-]{3,32}$ ]]; then
    echo -e "\n${cor1}Invalid username. Use 3-32 alphanumeric characters, dash, or underscore.${scor}\n"
    exit 1
fi

if id "$username" >/dev/null 2>&1; then
    echo -e "\n${cor1}User '$username' already exists.${scor}\n"
    exit 1
fi

read -r -s -p "Enter password (leave empty to generate random): " password
echo ""
if [[ -z "$password" ]]; then
    password=$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 12 || echo "Ax$(date +%s%N | tail -c 8)")
fi

read -r -p "Validity period in days [default 30]: " dias
dias="${dias:-30}"
if ! [[ "$dias" =~ ^[0-9]+$ ]] || [[ "$dias" -lt 1 ]]; then
    echo -e "\n${cor1}Days must be a positive integer.${scor}\n"
    exit 1
fi

read -r -p "Connection limit [default 1]: " sshlimiter
sshlimiter="${sshlimiter:-1}"
if ! [[ "$sshlimiter" =~ ^[0-9]+$ ]] || [[ "$sshlimiter" -lt 1 ]] || [[ "$sshlimiter" -gt 999 ]]; then
    echo -e "\n${cor1}Connection limit must be a positive integer (1-999).${scor}\n"
    exit 1
fi

final_date=$(date "+%Y-%m-%d" -d "+$dias days")
display_date=$(date "+%d/%m/%Y" -d "+$dias days")

# Ensure non-interactive shell is allowed in /etc/shells for SSH authentication
if ! grep -q "^/bin/false" /etc/shells 2>/dev/null; then
    echo "/bin/false" >> /etc/shells
fi
if ! grep -q "^/usr/sbin/nologin" /etc/shells 2>/dev/null; then
    echo "/usr/sbin/nologin" >> /etc/shells
fi

# Create user securely with false shell and expiration date
useradd -e "$final_date" -M -s /bin/false "$username" >/dev/null 2>&1
echo "$username:$password" | chpasswd

# Update database atomically on the same filesystem
touch /root/usuarios.db
tmp_db=$(mktemp /root/usuarios.db.XXXXXX)
grep -v "^${username}[[:space:]]" /root/usuarios.db > "$tmp_db" || true
echo "$username $sshlimiter" >> "$tmp_db"
mv "$tmp_db" /root/usuarios.db
chmod 644 /root/usuarios.db

# OpenVPN client profile generation (if OpenVPN is configured)
if [[ -d /etc/openvpn/easy-rsa && -f /etc/openvpn/client-common.txt ]]; then
    (
        cd /etc/openvpn/easy-rsa/
        ./easyrsa build-client-full "$username" nopass >/dev/null 2>&1 || true
        cp /etc/openvpn/client-common.txt "/root/${username}.ovpn"
        echo "<ca>" >> "/root/${username}.ovpn"
        cat pki/ca.crt >> "/root/${username}.ovpn" 2>/dev/null || true
        echo "</ca>" >> "/root/${username}.ovpn"
        echo "<cert>" >> "/root/${username}.ovpn"
        cat "pki/issued/${username}.crt" >> "/root/${username}.ovpn" 2>/dev/null || true
        echo "</cert>" >> "/root/${username}.ovpn"
        echo "<key>" >> "/root/${username}.ovpn"
        cat "pki/private/${username}.key" >> "/root/${username}.ovpn" 2>/dev/null || true
        echo "</key>" >> "/root/${username}.ovpn"
        chmod 600 "/root/${username}.ovpn"
    ) || true
fi

if type axiom_audit >/dev/null 2>&1; then
    axiom_audit "USER_CREATE" "$username" "days=$dias,limit=$sshlimiter"
fi

clear
echo -e "\033[1;36m============================================\033[0m"
echo -e "\033[1;33m       ⚡ AXIOM ACCOUNT PROVISIONED ⚡      \033[0m"
echo -e "\033[1;36m============================================\033[0m\n"
echo -e "  \033[1;32mServer IP     :\033[0m \033[1;37m$IP\033[0m"
echo -e "  \033[1;32mUsername      :\033[0m \033[1;37m$username\033[0m"
echo -e "  \033[1;32mPassword      :\033[0m \033[1;37m$password\033[0m"
echo -e "  \033[1;32mConn Limit    :\033[0m \033[1;37m$sshlimiter\033[0m"
echo -e "  \033[1;32mExpires On    :\033[0m \033[1;37m$display_date ($dias Days)\033[0m"
echo -e "\n\033[1;36m============================================\033[0m"
if [[ -f "/root/${username}.ovpn" ]]; then
    echo -e "\033[1;33m[✓] OpenVPN Profile saved to: /root/${username}.ovpn (chmod 600)\033[0m"
fi
echo ""
read -r -p "Press Enter to return to menu..."
