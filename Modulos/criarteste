#!/usr/bin/env bash
# Axiom VPS Manager — Temporary Trial Account Generator
set -euo pipefail

# Source common library
LIB_PATH="/etc/axiom/lib/axiom-common.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    LIB_PATH="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/lib/axiom-common.sh"
fi
if [[ -f "$LIB_PATH" ]]; then
    # shellcheck source=lib/axiom-common.sh
    source "$LIB_PATH"
fi

if type axiom_require_root >/dev/null 2>&1; then
    axiom_require_root
elif [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[!] Error: Axiom operations require root privileges.\033[0m" >&2
    exit 1
fi

IP=$(cat /etc/IP 2>/dev/null || curl -s -4 --connect-timeout 5 ifconfig.me || echo "127.0.0.1")
mkdir -p /etc/VPSManager/userteste

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%30s%s%-15s\n' "  Axiom - Create Trial Account  " ; tput sgr0
echo ""

read -r -p "Enter trial username (or press enter for random): " nome
if [[ -z "$nome" ]]; then
    nome="trial$((RANDOM % 8999 + 1000))"
fi

if ! [[ "$nome" =~ ^[a-zA-Z0-9_-]{3,32}$ ]]; then
    echo -e "\n\033[1;31m[!] Invalid username. Use 3-32 alphanumeric characters, dash, or underscore.\033[0m\n"
    exit 1
fi

if id "$nome" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User '$nome' already exists.\033[0m\n"
    exit 1
fi

read -r -s -p "Enter password (or press enter for random): " pass
echo ""
if [[ -z "$pass" ]]; then
    pass=$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 10 || echo "Ax$(date +%s%N | tail -c 8)")
fi

read -r -p "Validity duration in minutes [default 60]: " u_temp
u_temp="${u_temp:-60}"
if ! [[ "$u_temp" =~ ^[0-9]+$ ]] || [[ "$u_temp" -lt 1 ]]; then
    echo -e "\n\033[1;31m[!] Duration must be a positive integer.\033[0m\n"
    exit 1
fi

# Ensure non-interactive shell is allowed in /etc/shells for SSH authentication
if ! grep -q "^/bin/false" /etc/shells 2>/dev/null; then
    echo "/bin/false" >> /etc/shells
fi
if ! grep -q "^/usr/sbin/nologin" /etc/shells 2>/dev/null; then
    echo "/usr/sbin/nologin" >> /etc/shells
fi

# Create system user without interactive shell
useradd -M -s /bin/false "$nome" >/dev/null 2>&1
echo "$nome:$pass" | chpasswd

# Register in main usuarios.db atomically
touch /root/usuarios.db
tmp_db=$(mktemp /root/usuarios.db.XXXXXX)
grep -v "^${nome}[[:space:]]" /root/usuarios.db > "$tmp_db" || true
echo "$nome 1" >> "$tmp_db"
mv "$tmp_db" /root/usuarios.db
chmod 644 /root/usuarios.db

# Register in dedicated trial database
now_epoch=$(date +%s)
exp_epoch=$(( now_epoch + u_temp * 60 ))
mkdir -p /etc/VPSManager
touch /etc/VPSManager/trial_users.db
tmp_trial=$(mktemp /etc/VPSManager/trial_users.db.XXXXXX)
grep -v "^${nome}[[:space:]]" /etc/VPSManager/trial_users.db > "$tmp_trial" || true
echo "$nome $exp_epoch 1" >> "$tmp_trial"
mv "$tmp_trial" /etc/VPSManager/trial_users.db
chmod 644 /etc/VPSManager/trial_users.db

# Generate dedicated cleanup script
cleanup_script="/etc/VPSManager/userteste/${nome}.sh"
cat <<EOF > "$cleanup_script"
#!/usr/bin/env bash
pkill -u "$nome" 2>/dev/null || true
userdel -f "$nome" 2>/dev/null || true
if [[ -f /root/usuarios.db ]]; then
    tmp=\$(mktemp /root/usuarios.db.XXXXXX)
    grep -v "^${nome}[[:space:]]" /root/usuarios.db > "\$tmp" || true
    mv "\$tmp" /root/usuarios.db
    chmod 644 /root/usuarios.db 2>/dev/null || true
fi
if [[ -f /etc/VPSManager/trial_users.db ]]; then
    tmp_t=\$(mktemp /etc/VPSManager/trial_users.db.XXXXXX)
    grep -v "^${nome}[[:space:]]" /etc/VPSManager/trial_users.db > "\$tmp_t" || true
    mv "\$tmp_t" /etc/VPSManager/trial_users.db
    chmod 644 /etc/VPSManager/trial_users.db 2>/dev/null || true
fi
rm -f "$cleanup_script"
EOF
chmod +x "$cleanup_script"

# Queue via at daemon with guaranteed background sleep fallback
if command -v at >/dev/null 2>&1 && systemctl is-active --quiet atd 2>/dev/null; then
    echo "$cleanup_script" | at "now + $u_temp min" >/dev/null 2>&1 || ( sleep $(( u_temp * 60 )); bash "$cleanup_script" ) >/dev/null 2>&1 &
else
    ( sleep $(( u_temp * 60 )); bash "$cleanup_script" ) >/dev/null 2>&1 &
fi

if type axiom_audit >/dev/null 2>&1; then
    axiom_audit "TRIAL_CREATE" "$nome" "duration_min=$u_temp"
fi

clear
echo -e "\033[1;36m============================================\033[0m"
echo -e "\033[1;33m      ⚡ AXIOM TRIAL ACCOUNT CREATED ⚡     \033[0m"
echo -e "\033[1;36m============================================\033[0m\n"
echo -e "  \033[1;32mServer IP     :\033[0m \033[1;37m$IP\033[0m"
echo -e "  \033[1;32mUsername      :\033[0m \033[1;37m$nome\033[0m"
echo -e "  \033[1;32mPassword      :\033[0m \033[1;37m$pass\033[0m"
echo -e "  \033[1;32mDuration      :\033[0m \033[1;37m$u_temp Minutes\033[0m"
echo -e "\n\033[1;33m[!] Account will automatically expire and be removed after $u_temp minutes.\033[0m\n"
read -r -p "Press Enter to return to menu..."
