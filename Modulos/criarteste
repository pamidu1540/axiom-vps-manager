#!/usr/bin/env bash
# Axiom VPS Manager — Temporary Trial Account Generator
set -euo pipefail

IP=$(cat /etc/IP 2>/dev/null || curl -s -4 ifconfig.me || echo "127.0.0.1")
mkdir -p /etc/VPSManager/userteste

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%30s%s%-15s\n' "  Axiom - Create Trial Account  " ; tput sgr0
echo ""

read -r -p "Enter trial username (or press enter for random): " nome
if [[ -z "$nome" ]]; then
    nome="trial$((RANDOM % 8999 + 1000))"
fi

if id "$nome" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User '$nome' already exists.\033[0m\n"
    exit 1
fi

read -r -s -p "Enter password (or press enter for random): " pass
echo ""
if [[ -z "$pass" ]]; then
    pass=$(tr -dc A-Za-z0-9 </dev/urandom | head -c 10 || echo "$((RANDOM % 899999 + 100000))")
fi

read -r -p "Validity duration in minutes [default 60]: " u_temp
u_temp="${u_temp:-60}"

useradd -M -s /bin/false "$nome" >/dev/null 2>&1
echo "$nome:$pass" | chpasswd

touch /root/usuarios.db
echo "$nome 1" >> /root/usuarios.db

cleanup_script="/etc/VPSManager/userteste/${nome}.sh"
cat <<EOF > "$cleanup_script"
#!/usr/bin/env bash
pkill -u "$nome" 2>/dev/null || true
userdel -f "$nome" 2>/dev/null || true
tmp=\$(mktemp)
grep -v "^${nome}[[:space:]]" /root/usuarios.db > "\$tmp" || true
mv "\$tmp" /root/usuarios.db
rm -f "$cleanup_script"
EOF
chmod +x "$cleanup_script"
echo "$cleanup_script" | at "now + $u_temp min" >/dev/null 2>&1 || true

clear
echo -e "\033[1;36m============================================\033[0m"
echo -e "\033[1;33m      ⚡ AXIOM TRIAL ACCOUNT CREATED ⚡     \033[0m"
echo -e "\033[1;36m============================================\033[0m\n"
echo -e "  \033[1;32mServer IP     :\033[0m \033[1;37m$IP\033[0m"
echo -e "  \033[1;32mUsername      :\033[0m \033[1;37m$nome\033[0m"
echo -e "  \033[1;32mPassword      :\033[0m \033[1;37m$pass\033[0m"
echo -e "  \033[1;32mDuration      :\033[0m \033[1;37m$u_temp Minutes\033[0m"
echo -e "\n\033[1;33m[!] Account will automatically expire and be removed after $u_temp minutes.\033[0m\n"
read -r -p "Press Enter to return to menu..."
