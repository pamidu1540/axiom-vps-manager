#!/usr/bin/env bash
# Axiom VPS Manager — Expired Users Counter
set -euo pipefail

# Source common library
LIB_PATH="/etc/axiom/lib/axiom-common.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    LIB_PATH="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/lib/axiom-common.sh"
fi
if [[ -f "$LIB_PATH" ]]; then
    # shellcheck source=lib/axiom-common.sh
    source "$LIB_PATH"
fi

database="/root/usuarios.db"
touch "$database"
trial_db="/etc/VPSManager/trial_users.db"
datenow=$(date +%s)
userexp=0

# Track seen users to avoid double-counting
declare -A counted_users

while read -r user_entry; do
    [[ -z "$user_entry" ]] && continue
    user=$(echo "$user_entry" | awk '{print $1}')
    [[ -z "$user" ]] && continue
    if id "$user" >/dev/null 2>&1; then
        expdate=$(chage -l "$user" 2>/dev/null | awk -F: '/Account expires/{print $2}' | xargs || echo "never")
        if [[ "$expdate" != "never" && -n "$expdate" ]]; then
            expsec=$(date +%s --date="$expdate 23:59:59" 2>/dev/null || date +%s --date="$expdate" 2>/dev/null || echo "$datenow")
            if (( datenow > expsec )); then
                userexp=$((userexp + 1))
                counted_users["$user"]=1
            fi
        fi
    fi
done < "$database"

if [[ -f "$trial_db" ]]; then
    while read -r trial_entry; do
        [[ -z "$trial_entry" ]] && continue
        t_user=$(echo "$trial_entry" | awk '{print $1}')
        t_exp=$(echo "$trial_entry" | awk '{print $2}')
        [[ -z "$t_user" || -z "$t_exp" ]] && continue
        if [[ -n "${counted_users[$t_user]:-}" ]]; then
            continue
        fi
        if id "$t_user" >/dev/null 2>&1; then
            if (( datenow >= t_exp )); then
                userexp=$((userexp + 1))
                counted_users["$t_user"]=1
            fi
        fi
    done < "$trial_db"
fi

mkdir -p /etc/VPSManager
echo "$userexp" > /etc/VPSManager/Exp