#!/usr/bin/env bash
set -euo pipefail

remove_ovp () {
    local user="$1"
    local groupname="nogroup"
    if [[ -d /etc/openvpn/easy-rsa ]]; then
        (
            cd /etc/openvpn/easy-rsa/
            ./easyrsa --batch revoke "$user" 2>/dev/null || true
            ./easyrsa gen-crl 2>/dev/null || true
            rm -f "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt"
            cp pki/crl.pem /etc/openvpn/crl.pem 2>/dev/null || true
            chown "nobody:$groupname" /etc/openvpn/crl.pem 2>/dev/null || true
        )
    fi
    rm -f "$HOME/$user.ovpn"
    rm -f "/var/www/html/openvpn/$user.zip" 2>/dev/null || true
}

database="/root/usuarios.db"
touch "$database"

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%32s%s%-13s\n' "  Axiom - Remove SSH User  " ; tput sgr0
echo ""
echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m REMOVE A SINGLE USER"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m REMOVE ALL MANAGED USERS"
echo -e "\033[1;31m[\033[1;36m0\033[1;31m]\033[1;33m RETURN"
echo ""
read -r -p "Selection: " resp

if [[ "$resp" == "1" ]]; then
    clear
    echo -e "\033[1;33m=== Managed User List ===\033[0m\n"
    
    mapfile -t users_list < <(awk '{print $1}' "$database" | sort -u)
    if [[ ${#users_list[@]} -eq 0 ]]; then
        echo -e "\033[1;31mNo managed users found in database.\033[0m"
        exit 0
    fi

    for i in "${!users_list[@]}"; do
        idx=$((i + 1))
        echo -e "[\033[1;32m$idx\033[0m] ${users_list[$i]}"
    done
    echo ""
    read -r -p "Enter user number or username to remove: " sel

    target_user=""
    if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#users_list[@]} )); then
        target_user="${users_list[$((sel - 1))]}"
    elif grep -qw "$sel" "$database"; then
        target_user="$sel"
    fi

    if [[ -n "$target_user" ]]; then
        pkill -u "$target_user" 2>/dev/null || true
        userdel -f "$target_user" 2>/dev/null || true
        
        # Safe database update without static /tmp collisions
        tmp_db=$(mktemp)
        grep -v "^${target_user}[[:space:]]" "$database" > "$tmp_db" || true
        mv "$tmp_db" "$database"
        
        [[ -e /etc/openvpn/server.conf ]] && remove_ovp "$target_user"
        echo -e "\n\033[1;32m[✓] User $target_user successfully removed.\033[0m"
    else
        echo -e "\n\033[1;31m[!] Invalid user selection.\033[0m"
    fi

elif [[ "$resp" == "2" ]]; then
    read -r -p "Are you sure you want to remove ALL managed users? [y/N]: " confirm
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        while read -r user_entry; do
            u=$(echo "$user_entry" | awk '{print $1}')
            [[ -z "$u" ]] && continue
            pkill -u "$u" 2>/dev/null || true
            userdel -f "$u" 2>/dev/null || true
            [[ -e /etc/openvpn/server.conf ]] && remove_ovp "$u"
        done < "$database"
        
        > "$database"
        echo -e "\n\033[1;32m[✓] All managed users removed.\033[0m"
    else
        echo -e "\n\033[1;33mCancelled.\033[0m"
    fi
fi
