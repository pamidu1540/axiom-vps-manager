#!/usr/bin/env bash
# Axiom VPS Manager — Change Connection Limit Module
set -euo pipefail

database="/root/usuarios.db"
touch "$database"

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-10s\n' "  Axiom - Change Connection Limit  " ; tput sgr0
echo ""

mapfile -t users_list < <(awk '{print $1}' "$database" | sort -u)
if [[ ${#users_list[@]} -eq 0 ]]; then
    echo -e "\033[1;31mNo managed users found.\033[0m\n"
    exit 0
fi

echo -e "\033[1;33mManaged Users & Current Limits:\033[0m\n"
for i in "${!users_list[@]}"; do
    idx=$((i + 1))
    u="${users_list[$i]}"
    curr_limit=$(grep -w "^$u" "$database" | awk '{print $2}' || echo "1")
    [[ -z "$curr_limit" ]] && curr_limit="1"
    echo -e "[\033[1;32m$idx\033[0m] \033[1;37m$u\033[0m — Current Limit: \033[1;36m$curr_limit\033[0m"
done
echo ""

read -r -p "Enter user number or username: " sel
target_user=""
if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#users_list[@]} )); then
    target_user="${users_list[$((sel - 1))]}"
elif grep -qw "$sel" "$database"; then
    target_user="$sel"
fi

if [[ -z "$target_user" ]] || ! id "$target_user" >/dev/null 2>&1; then
    echo -e "\n\033[1;31m[!] User not found.\033[0m\n"
    exit 1
fi

read -r -p "Enter new connection limit for $target_user [1-999]: " new_limit
if ! [[ "$new_limit" =~ ^[0-9]+$ ]] || [[ "$new_limit" -lt 1 ]]; then
    echo -e "\n\033[1;31m[!] Connection limit must be a positive integer.\033[0m\n"
    exit 1
fi

tmp_db=$(mktemp)
grep -v "^${target_user}[[:space:]]" "$database" > "$tmp_db" || true
echo "$target_user $new_limit" >> "$tmp_db"
mv "$tmp_db" "$database"

echo -e "\n\033[1;32m[✓] Limit for '$target_user' successfully updated to $new_limit connection(s).\033[0m\n"
read -r -p "Press Enter to return to menu..."
