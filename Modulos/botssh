#!/bin/bash

clear
fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        ${comando[0]} -y >/dev/null 2>&1
        ${comando[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "\033[1;33m["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.1s
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        echo -e "\033[1;33m]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "\033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
    tput cnorm
}

fun_botOnOff() {
    [[ $(ps x | grep "bot_plus" | grep -v grep | wc -l) = '0' ]] && {
        clear
        echo -e "\E[44;1;37m        ⚡ AXIOM VPS MANAGER — TELEGRAM BOT ⚡        \E[0m\n"
        echo -ne "\033[1;32m◇ ENTER YOUR BOT TOKEN:\033[1;37m "
        read -r tokenbot
        echo ""
        echo -ne "\033[1;32m◇ ENTER YOUR TELEGRAM ADMIN ID:\033[1;37m "
        read -r iduser
        clear
        fun_bot1() {
            [[ ! -f "/etc/VPSManager/ShellBot.sh" ]] && {
                curl -sSL -o /etc/VPSManager/ShellBot.sh https://raw.githubusercontent.com/pamidu1540/axiom-vps-manager/main/Install/ShellBot.sh >/dev/null 2>&1 || true
            }
            cd /etc/VPSManager
            screen -dmS bot_plus ./bot "$tokenbot" "$iduser" >/dev/null 2>&1
            sed -i '/bot_plus/d' /etc/autostart 2>/dev/null || true
            echo -e "ps x | grep 'bot_plus' | grep -v 'grep' || cd /etc/VPSManager && sudo screen -dmS bot_plus ./bot $tokenbot $iduser && cd $HOME" >>/etc/autostart
            if ! crontab -l 2>/dev/null | grep -q "verifbot"; then
                (
                    crontab -l 2>/dev/null || true
                    echo "@daily /usr/local/bin/verifbot"
                ) | crontab - 2>/dev/null || true
            fi
            cd "$HOME"
        }
        fun_bar 'fun_bot1'
        [[ $(ps x | grep "bot_plus" | grep -v grep | wc -l) != '0' ]] && echo -e "\n\033[1;32m[✓] AXIOM TELEGRAM BOT ACTIVATED!\033[0m" || echo -e "\n\033[1;31m[!] Failed to start bot. Check your Token and ID.\033[0m"
        sleep 2
    } || {
        clear
        echo -e "\033[1;33m⚡ Stopping Axiom Telegram Bot...\033[0m\n"
        fun_bot2() {
            screen -r -S "bot_plus" -X quit 2>/dev/null || true
            screen -wipe 1>/dev/null 2>/dev/null || true
            sed -i '/bot_plus/d' /etc/autostart 2>/dev/null || true
            crontab -l 2>/dev/null | grep -v 'verifbot' | crontab - 2>/dev/null || true
            sleep 1
        }
        fun_bar 'fun_bot2'
        echo -e "\n\033[1;32m[✓] AXIOM TELEGRAM BOT STOPPED.\033[0m"
        sleep 2
    }
}

fun_instbot() {
    echo -e "\E[44;1;37m        ⚡ AXIOM VPS MANAGER — TELEGRAM BOT ⚡        \E[0m\n"
    echo -e "                 \033[1;33m[\033[1;31m!\033[1;33m] \033[1;31mINSTRUCTIONS \033[1;33m[\033[1;31m!\033[1;33m]\033[0m"
    echo -e "\n\033[1;32m1° \033[1;37m- \033[1;33mOpen Telegram and search for \033[1;37m@BotFather\033[0m"
    echo -e "\n\033[1;32m2° \033[1;37m- \033[1;33mSend \033[1;37m/newbot\033[1;33m to create your bot and copy the API Token\033[0m"
    echo -e "\n\033[1;32m3° \033[1;37m- \033[1;33mSearch for \033[1;37m@userinfobot\033[1;33m or \033[1;37m@TwincyBot\033[1;33m to obtain your Admin ID\033[0m"
    echo -e "\033[0;34m◇────────────────────────────────────────────────◇\033[1;32m"
    echo ""
    read -r -p "◇ Do you wish to continue? [y/N]: " resposta
    [[ "$resposta" =~ ^[yYsS]$ ]] && {
        fun_botOnOff
    } || {
        echo -e "\n\033[1;31m◇ Returning...\033[0m"
        sleep 1
    }
}
[[ -f "/etc/VPSManager/ShellBot.sh" ]] && fun_botOnOff || fun_instbot
#fim
