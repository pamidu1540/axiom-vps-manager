#!/usr/bin/env bash
# Axiom VPS Manager — Dropbear Multi-Login Limiter

database="/root/usuarios.db"
touch "$database" 2>/dev/null || true

clear
echo -e "\E[42;1;37m        ⚡ Axiom - Dropbear Connection Monitor ⚡        \E[0m"
echo -e "\E[42;1;37m Username                       Active / Limit        \E[0m\n"

while read -r usline; do
    [[ -z "$usline" ]] && continue
    user=$(echo "$usline" | awk '{print $1}')
    limit=$(echo "$usline" | awk '{print $2}')
    [[ -z "$limit" || "$limit" -lt 1 ]] && limit=1

    if ! id "$user" >/dev/null 2>&1; then
        continue
    fi

    # Detect active Dropbear processes for this user
    mapfile -t drop_pids < <(pgrep -u "$user" dropbear 2>/dev/null || true)
    active_count="${#drop_pids[@]}"

    tput setaf 3 ; tput bold ; printf ' %-30s %s\n' "$user" "$active_count / $limit" ; tput sgr0

    if (( active_count > limit )); then
        excess=$(( active_count - limit ))
        for (( i=0; i<excess; i++ )); do
            pid_to_kill="${drop_pids[$(( active_count - 1 - i ))]}"
            kill -9 "$pid_to_kill" 2>/dev/null || true
        done
        echo -e "   \033[1;31m└─> Terminated $excess excess session(s) for $user\033[0m"
    fi
done < "$database"

echo ""
