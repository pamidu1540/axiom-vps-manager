#!/usr/bin/env bash
set -euo pipefail
source ShellBot.sh
touch lista

[[ ! -e RESET ]] && touch RESET
api_bot="${1:-}"
[[ -z "$api_bot" ]] && { echo "Usage: $0 <bot_token>"; exit 1; }

ShellBot.init --token "$api_bot" --monitor --flush
ShellBot.username

# Menu function
menu() {
    local msg="<b>• Axiom Trial Access Portal •</b>\n\nClick below to generate a temporary test account."
    ShellBot.sendMessage --chat_id "${message_chat_id[$id]}" \
        --text "$msg" \
        --reply_markup "$keyboard1" \
        --parse_mode html
    return 0
}

# Create temporary SSH trial
criarteste() {
    if grep -qw "${callback_query_from_id}" lista; then
        ShellBot.sendMessage --chat_id "${callback_query_message_chat_id}" \
            --text "You have already generated a trial account."
        return 0
    fi

    usuario="test$((RANDOM % 8999 + 1000))"
    senha=$(tr -dc A-Za-z0-9 </dev/urandom | head -c 10 || echo "$((RANDOM % 899999 + 100000))")
    limite='1'
    tempo='1'
    tuserdate=$(date '+%Y-%m-%d' -d "+1 days")
    
    useradd -M -N -s /bin/false "$usuario" -e "$tuserdate" >/dev/null 2>&1
    echo "$usuario:$senha" | chpasswd
    echo "$usuario $limite" >> /root/usuarios.db

    cleanup_script="/etc/VPSManager/userteste/${usuario}.sh"
    mkdir -p /etc/VPSManager/userteste
    cat <<EOF > "$cleanup_script"
#!/usr/bin/env bash
pkill -u "$usuario" 2>/dev/null || true
userdel -f "$usuario" 2>/dev/null || true
tmp=\$(mktemp)
grep -v "^${usuario}[[:space:]]" /root/usuarios.db > "\$tmp" || true
mv "\$tmp" /root/usuarios.db
rm -f "$cleanup_script"
EOF
    chmod +x "$cleanup_script"
    echo "$cleanup_script" | at "now + $tempo hour" >/dev/null 2>&1 || true

    echo "${callback_query_from_id}" >> lista

    ip_addr="$(cat /etc/IP 2>/dev/null || curl -s -4 ifconfig.me || echo '127.0.0.1')"
    response="✅ <b>Trial Account Created</b>\n\n"
    response+="Server: <code>$ip_addr</code>\n"
    response+="Username: <code>$usuario</code>\n"
    response+="Password: <code>$senha</code>\n\n"
    response+="⏳ <b>Valid For:</b> $tempo Hour"

    ShellBot.sendMessage --chat_id "${callback_query_message_chat_id}" \
        --text "$response" \
        --parse_mode html
    return 0
}

infouser() {
    ShellBot.sendMessage --chat_id "${message_chat_id[$id]}" \
        --text "User ID: ${message_from_id[$(ShellBot.ListUpdates)]}" \
        --parse_mode html
    return 0
}

unset botao1
botao1=''
ShellBot.InlineKeyboardButton --button 'botao1' --line 1 --text '⚡ GENERATE TRIAL ACCOUNT' --callback_data 'gerarssh'
ShellBot.regHandleFunction --function criarteste --callback_data gerarssh

unset keyboard1
keyboard1="$(ShellBot.InlineKeyboardMarkup -b 'botao1')"

while :; do
    ShellBot.getUpdates --limit 100 --offset "$(ShellBot.OffsetNext)" --timeout 30
    for id in $(ShellBot.ListUpdates); do
        (
            ShellBot.watchHandle --callback_data "${callback_query_data[$id]:-}"
            comando=(${message_text[$id]:-})
            [[ "${comando[0]:-}" = "/menu" || "${comando[0]:-}" = "/start" ]] && menu
            [[ "${comando[0]:-}" = "/id" ]] && infouser
        ) &
    done
done
