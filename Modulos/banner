#!/usr/bin/env bash
# Axiom VPS Manager — SSH & Dropbear Banner Manager

local="/etc/bannerssh"
touch "$local"
chmod 644 "$local" 2>/dev/null || true

# Safe SSH Banner Configuration
if [[ -f /etc/ssh/sshd_config ]]; then
    if grep -qE '^#?Banner ' /etc/ssh/sshd_config; then
        sed -i -E 's|^#?Banner .*|Banner /etc/bannerssh|' /etc/ssh/sshd_config
    else
        echo "Banner /etc/bannerssh" >> /etc/ssh/sshd_config
    fi
fi

# Safe Dropbear Banner Configuration
if [[ -f /etc/default/dropbear ]]; then
    if grep -qE '^#?DROPBEAR_BANNER=' /etc/default/dropbear; then
        sed -i -E 's|^#?DROPBEAR_BANNER=.*|DROPBEAR_BANNER="/etc/bannerssh"|' /etc/default/dropbear
    else
        echo 'DROPBEAR_BANNER="/etc/bannerssh"' >> /etc/default/dropbear
    fi
fi

restart_services() {
    service ssh restart > /dev/null 2>&1 || systemctl restart ssh > /dev/null 2>&1 || systemctl restart sshd > /dev/null 2>&1 || true
    service dropbear restart > /dev/null 2>&1 || systemctl restart dropbear > /dev/null 2>&1 || true
}

if [[ -t 0 ]]; then
    clear
    echo -e "\E[44;1;37m        ⚡ Axiom SSH & Dropbear Banner Manager ⚡        \E[0m\n"
    echo -e "\033[1;32m[1]\033[0m Add Colorized / Formatted Banner"
    echo -e "\033[1;32m[2]\033[0m Remove Existing Banner"
    echo -e "\033[1;31m[0]\033[0m Return to Menu\n"

    read -r -p "Select an option [0-2]: " resp
else
    resp="${1:-0}"
fi

if [[ "$resp" == "1" ]]; then
    if [[ -t 0 ]]; then
        echo ""
        read -r -p "Enter the banner message text: " msg1
        if [[ -z "$msg1" ]]; then
            echo -e "\n\033[1;31m[!] Empty message. Operation cancelled.\033[0m"
            read -r -p "⚡ Press [ENTER] to return..."
            exit 0
        fi

        echo -e "\n[1] Small  [2] Medium  [3] Large  [4] Extra Large"
        read -r -p "Select font size [1-4]: " opc
        case "$opc" in
            1|01) _size='6' ;;
            2|02) _size='4' ;;
            3|03) _size='3' ;;
            4|04) _size='1' ;;
            *)    _size='4' ;;
        esac

        echo -e "\n[01] Blue   [02] Green  [03] Red     [04] Yellow [05] Pink"
        echo -e "[06] Cyan   [07] Orange [08] Purple  [09] Black  [10] Plain (No Color)"
        read -r -p "Select color [1-10]: " ban_cor
    else
        msg1="${2:-Welcome to Axiom VPS}"
        _size='4'
        ban_cor="${3:-10}"
    fi

    case "$ban_cor" in
        1|01) echo "<h$_size><font color='blue'>$msg1</font></h$_size>" >> "$local" ;;
        2|02) echo "<h$_size><font color='green'>$msg1</font></h$_size>" >> "$local" ;;
        3|03) echo "<h$_size><font color='red'>$msg1</font></h$_size>" >> "$local" ;;
        4|04) echo "<h$_size><font color='yellow'>$msg1</font></h$_size>" >> "$local" ;;
        5|05) echo "<h$_size><font color='#F535AA'>$msg1</font></h$_size>" >> "$local" ;;
        6|06) echo "<h$_size><font color='cyan'>$msg1</font></h$_size>" >> "$local" ;;
        7|07) echo "<h$_size><font color='#FF7F00'>$msg1</font></h$_size>" >> "$local" ;;
        8|08) echo "<h$_size><font color='#9932CD'>$msg1</font></h$_size>" >> "$local" ;;
        9|09) echo "<h$_size><font color='black'>$msg1</font></h$_size>" >> "$local" ;;
        10)   echo "<h$_size>$msg1</h$_size>" >> "$local" ;;
        *)    echo "$msg1" >> "$local" ;;
    esac

    restart_services
    echo -e "\n\033[1;32m[✓] Banner successfully added to $local and services restarted.\033[0m"
    if [[ -t 0 ]]; then
        sleep 2
    fi
elif [[ "$resp" == "2" ]]; then
    > "$local"
    restart_services
    echo -e "\n\033[1;32m[✓] Banner cleared and services restarted.\033[0m"
    if [[ -t 0 ]]; then
        sleep 2
    fi
else
    exit 0
fi
