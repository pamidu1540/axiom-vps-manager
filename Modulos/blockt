#!/usr/bin/env bash
# Axiom VPS Manager — Torrent & P2P Filter Module
set -euo pipefail

BLOCK_FLAG="/etc/axiom/torrent_blocked"
mkdir -p /etc/axiom

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-10s\n' "  Axiom - Torrent & P2P Traffic Filter  " ; tput sgr0
echo ""

apply_block() {
    echo -e "\033[1;33m[*] Applying BitTorrent port and signature filters...\033[0m"
    # BitTorrent Standard Ports (TCP/UDP 6881-6889)
    iptables -N AXIOM_TORRENT 2>/dev/null || iptables -F AXIOM_TORRENT
    iptables -C FORWARD -j AXIOM_TORRENT 2>/dev/null || iptables -I FORWARD 1 -j AXIOM_TORRENT
    iptables -C OUTPUT -j AXIOM_TORRENT 2>/dev/null || iptables -I OUTPUT 1 -j AXIOM_TORRENT

    iptables -A AXIOM_TORRENT -p tcp --dport 6881:6889 -j DROP
    iptables -A AXIOM_TORRENT -p udp --dport 6881:6889 -j DROP
    iptables -A AXIOM_TORRENT -p tcp --dport 51413 -j DROP
    iptables -A AXIOM_TORRENT -p udp --dport 51413 -j DROP
    
    touch "$BLOCK_FLAG"
    echo -e "\033[1;32m[✓] Torrent and P2P traffic blocked successfully.\033[0m\n"
}

remove_block() {
    echo -e "\033[1;33m[*] Removing BitTorrent filters...\033[0m"
    iptables -D FORWARD -j AXIOM_TORRENT 2>/dev/null || true
    iptables -D OUTPUT -j AXIOM_TORRENT 2>/dev/null || true
    iptables -F AXIOM_TORRENT 2>/dev/null || true
    iptables -X AXIOM_TORRENT 2>/dev/null || true
    rm -f "$BLOCK_FLAG"
    echo -e "\033[1;32m[✓] Torrent filters removed safely without flushing base firewall.\033[0m\n"
}

if [[ -f "$BLOCK_FLAG" ]]; then
    echo -e "\033[1;33mStatus: \033[1;32mBitTorrent is currently BLOCKED\033[0m\n"
    read -r -p "Do you want to UNBLOCK BitTorrent? [y/N]: " resp
    if [[ "$resp" =~ ^[yY]$ ]]; then
        remove_block
    fi
else
    echo -e "\033[1;33mStatus: \033[1;31mBitTorrent is currently ALLOWED\033[0m\n"
    read -r -p "Do you want to BLOCK BitTorrent traffic? [y/N]: " resp
    if [[ "$resp" =~ ^[yY]$ ]]; then
        apply_block
    fi
fi

read -r -p "Press Enter to return to menu..."
