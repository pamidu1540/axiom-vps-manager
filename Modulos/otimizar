#!/usr/bin/env bash
# Axiom VPS Manager — System Optimization & Resource Maintenance Module
set -euo pipefail

clear
echo -e "\E[44;1;37m           ⚡ Axiom System Optimizer ⚡           \E[0m\n"

echo -e "\033[1;33m[*] Cleaning package caches and stale files...\033[0m"
apt-get autoremove -y >/dev/null 2>&1 || true
apt-get autoclean -y >/dev/null 2>&1 || true
apt-get clean >/dev/null 2>&1 || true

echo -e "\033[1;33m[*] Flushing page caches, dentries, and inodes...\033[0m"
sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

# Safe Swap Recycling (Check available RAM first)
avail_mem_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo || echo "0")
used_swap_kb=$(awk '/SwapTotal/ {t=$2} /SwapFree/ {f=$2} END {print (t-f)}' /proc/meminfo || echo "0")

if (( avail_mem_kb > used_swap_kb + 204800 && used_swap_kb > 10240 )); then
    echo -e "\033[1;33m[*] Safely cycling swap memory (available RAM is sufficient)...\033[0m"
    swapoff -a 2>/dev/null || true
    swapon -a 2>/dev/null || true
else
    echo -e "\033[1;32m[*] Swap cycling bypassed to preserve memory safety.\033[0m"
fi

echo -e "\n\033[1;32m[✓] System optimization completed successfully.\033[0m\n"
free -h
echo ""
read -r -p "Press Enter to return to menu..."
