#!/bin/bash
clear
source ShellBot.sh
api_bot=$1
id_admin=$2
ShellBot.init --token "$api_bot" --monitor --flush
ShellBot.username

# - Funcao menu
menu() {

[[ "${message_from_id[$id]}" == "$id_admin" ]] && {

    local msg
        msg="◇──────────────────◇\n"
        msg+="<b>•🔹• ⚡ AXIOM VPS MANAGER ⚡ •🔹•</b>\n"
        msg+="◇──────────────────◇\n\n"
        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
        --text "$(echo -e $msg)" \
        --reply_markup "$keyboard1" \
        --parse_mode html
        return 0
       

  } 
   ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
    --text "$(echo -e 🚫 ACCESS DENIED 🚫)"
    return 0
    
}

# - funcao criar ssh
criarssh30() {
    usuario=$(echo BR$(( RANDOM% + 999999)))
    senha=$((RANDOM% + 99999))
    limite='1'
    tempo='31'
    final=$(date "+%Y-%m-%d" -d "+$tempo days")
    gui=$(date "+%d/%m/%Y" -d "+$tempo days")
    
    if [[ "$(grep -wc $usuario /etc/passwd)" != '0' ]]; then
        ShellBot.sendMessage --chat_id ${callback_query_message_chat_id} \
            --text "◇ GENERATED ACCOUNT ALREADY EXISTS! TRY AGAIN"
        return 0
    else
        useradd -e $final -M -s /bin/false $usuario >/dev/null 2>&1
        echo "$usuario:$senha" | chpasswd
        echo "$usuario $limite" >> /root/usuarios.db

        # - ENVIA O SSH
        ShellBot.sendMessage --chat_id ${callback_query_message_chat_id} \
            --text "$(echo -e "✅ <b>successfully created</b> ✅\n\n<b>SERVER</b>: $(cat /etc/IP 2>/dev/null || echo "127.0.0.1") \n<b>USERNAME</b>: <code>$usuario</code>\n<b>PASSWORD</b>: <code>$senha</code>\n<b>EXPIRE</b>: 01\n\n⏳ Expira em: $gui ")" \
            --parse_mode html
        return 0
    fi
}

