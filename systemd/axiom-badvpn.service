[Unit]
Description=Axiom BadVPN UDP Gateway Daemon
After=network.target

[Service]
Type=simple
ExecStart=/bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 10000 --max-connections-for-client 8 --client-socket-sndbuf 10000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=axiom-badvpn

[Install]
WantedBy=multi-user.target
