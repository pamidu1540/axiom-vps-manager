[Unit]
Description=Axiom Telegram Automation Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/axiom/axiom.env
ExecStart=/opt/axiom/.venv/bin/python -m axiom.telegram.bot
UMask=0077
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=axiom-bot

[Install]
WantedBy=multi-user.target
